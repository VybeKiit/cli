# ─────────────────────────────────────────────────────────────────────────────
# VybeKiit — single source of truth for every secret/setting.
# Copy to `.env` and fill in. NEVER commit `.env` (only this example is tracked).
# `@vybekiit/core` loads + validates these with Zod; missing/invalid keys fail loud.
# Keys are grouped by the skill that fills them. Future-version keys are marked.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL of the deployed app (used for callbacks / redirects).
APP_URL="http://localhost:3000"
# "development" | "production"
NODE_ENV="development"

# ── Payments · @vybekiit/payments ────────────────────────────────────────────
# Which adapter to run: "lemon-squeezy" (default) | "stripe" | "paypal".
# Only fill the keys for the provider you pick; the others can stay blank.
PAYMENTS_PROVIDER="lemon-squeezy"

# Lemon Squeezy (v1 default — Merchant of Record). Get from app.lemonsqueezy.com.
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
# Signing secret for verifying incoming webhooks (order_created / refunded).
LEMONSQUEEZY_WEBHOOK_SECRET=""

# Stripe (alternative). Get from dashboard.stripe.com.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# PayPal (alternative). Get from developer.paypal.com. PAYPAL_ENV: "sandbox" | "live".
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_ENV="sandbox"

# ── Auth · @vybekiit/auth ────────────────────────────────────────────────────
# Filled by the add-signin skill; the builder never edits these by hand.
# Which auth adapter to run: "better-auth" (default, DB-bound) | "cognito" (AWS).
# better-auth follows DATA_PROVIDER: it stores its tables in the same database your
# data uses (Postgres for Supabase, Mongo for MongoDB). DATA_PROVIDER="aws" auto-uses
# Cognito, since DynamoDB has no better-auth adapter (ADR-0003).
AUTH_PROVIDER="better-auth"
# better-auth — only read when AUTH_PROVIDER="better-auth".
# Session signing secret (generate: openssl rand -base64 32). Base URL defaults to APP_URL.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=""
# Postgres connection string better-auth opens when data is Postgres/Supabase.
# Supabase exposes it in Project Settings → Database (Mongo apps leave this blank).
DATABASE_URL=""
# AWS Cognito — only read when auth resolves to Cognito (AUTH_PROVIDER="cognito" or
# DATA_PROVIDER="aws"). Region reuses AWS_REGION below.
COGNITO_USER_POOL_ID=""
COGNITO_CLIENT_ID=""

# ── Database · @vybekiit/db ──────────────────────────────────────────────────
# Used by @vybekiit/db. Get from your Supabase project settings.
# Which data adapter to run: "supabase" (default) | "neon" | "firebase" | "mongodb" | "aws".
DATA_PROVIDER="supabase"
# Which file-storage adapter to run: "supabase" (default) | "r2" | "s3".
# Doctor provisions R2 on the default Cloudflare stack (ADR-0010).
STORAGE_PROVIDER="supabase"
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
# Server-only. Never expose to the browser / client bundle.
SUPABASE_SERVICE_ROLE_KEY=""

# Neon — only when DATA_PROVIDER="neon". Pooled connection string from Neon dashboard.
# DATABASE_URL=""  # same key better-auth uses for Postgres
# Optional for doctor/MCP (never commit):
# NEON_API_KEY=""

# Firebase Firestore — only when DATA_PROVIDER="firebase".
# FIREBASE_PROJECT_ID=""
# FIREBASE_SERVICE_ACCOUNT_JSON=""  # inline JSON string (server-only)
# GOOGLE_APPLICATION_CREDENTIALS=""  # path to service account JSON file

# Cloudflare R2 — provisioned by doctor on HOSTING_PROVIDER=cloudflare.
R2_ACCOUNT_ID=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_URL=""

# MongoDB Atlas — only fill when DATA_PROVIDER="mongodb". Provisioned by the
# save-data/doctor skills; the builder never sets these by hand. URI is the Atlas
# SRV connection string (mongodb+srv://...); DB is the database name.
MONGODB_URI=""
MONGODB_DB=""

# AWS DynamoDB — only fill when DATA_PROVIDER="aws". Provisioned by the
# save-data/doctor skills. AWS_REGION is required; leave the access keys blank to
# use the deploy environment's default credential chain (instance role, etc.).
# AWS_DYNAMODB_TABLE_PREFIX optionally namespaces table names (e.g. "prod_").
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_DYNAMODB_TABLE_PREFIX=""
# AWS reuses these region/credential keys for S3 storage (STORAGE_PROVIDER="s3") and
# SES email (EMAIL_PROVIDER="ses"). The Amplify keys below are only read when
# HOSTING_PROVIDER="aws"; the go-live skill provisions the Amplify app and fills them.
# Branch defaults to "main".
AWS_AMPLIFY_APP_ID=""
AWS_AMPLIFY_BRANCH="main"

# ── Infra · Cloudflare (hosting, edge, domains, cron, R2, email) ─────────────
# Used at deploy time (@vybekiit/deploy) and by @vybekiit/email. From the CF dashboard.
# Which hosting adapter to run: "cloudflare" (default) | "vercel" | "aws".
HOSTING_PROVIDER="cloudflare"
# Which email adapter to run: "cloudflare" (default) | "ses" | "resend".
EMAIL_PROVIDER="cloudflare"
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
# Worker/Pages route that sends transactional mail (Cloudflare has no outbound API).
CLOUDFLARE_EMAIL_ENDPOINT=""

# ── Infra · Vercel (opt-in hosting — ADR-0006) ───────────────────────────────
# Only read when HOSTING_PROVIDER="vercel". Token from Vercel dashboard → Settings → Tokens.
# VERCEL_ORG_ID / VERCEL_PROJECT_ID optional until go-live links the project.
VERCEL_TOKEN=""
VERCEL_ORG_ID=""
VERCEL_PROJECT_ID=""

# ── The gate · GitHub access automation ──────────────────────────────────────
# Server-only token used by the order webhook to invite/remove buyers on the
# private repo. Needs repo + admin:org (invite) scope. Maintainer infra only.
GITHUB_GATE_TOKEN=""
GITHUB_GATE_ORG="VybeKiit"
# CSV of private template mirror repos invited on purchase (ADR-0005).
GITHUB_GATE_REPOS="web,mobile,extension"

# ── The store · apps/landing checkout ────────────────────────────────────────
# What the VybeKiit store sells: the payment provider's purchasable id for the kit
# (a Lemon Squeezy variant id by default). The checkout route passes this as the
# checkout's productId. Store infrastructure only — a buyer's app carries its own.
STORE_PRODUCT_ID=""

# ── Product surface (ADR-0012) ───────────────────────────────────────────────
# JOBS_PROVIDER=cloudflare          # cloudflare | trigger | qstash | local
# CLOUDFLARE_QUEUE_NAME=""
# CLOUDFLARE_CRON_SECRET=""
# ANALYTICS_PROVIDER=plausible        # plausible | posthog | local
# PLAUSIBLE_DOMAIN=""
# NOTIFICATIONS_PROVIDER=expo         # expo | twilio | email | local
# EXPO_ACCESS_TOKEN=""
# AI_PROVIDER=openai                  # openai | anthropic | openrouter | local
# OPENAI_API_KEY=""
# SEARCH_PROVIDER=supabase            # supabase | typesense | algolia | local
# REALTIME_PROVIDER=supabase          # supabase | cloudflare-do | local
# CMS_PROVIDER=mdx                    # mdx | local
# CMS_CONTENT_DIR="content"
# CLIENT_STATE_PERSIST=on                 # on | off — client query cache persist
# CLIENT_STATE_QUERY_STALE_SECONDS=60     # seconds before refetch
# KV_PROVIDER=cloudflare              # cloudflare | upstash | local
# CLOUDFLARE_KV_NAMESPACE_ID=""
# TENANCY_PROVIDER=better-auth        # better-auth | local
# RESEND_API_KEY=""                   # when EMAIL_PROVIDER=resend

# ── Maintainer · UI registry sync (not buyer-facing) ───────────────────────
# API_KEY_21ST=""  # 21st.dev team API key — https://21st.dev/team/api-keys

# ── The store · apps/landing checkout ────────────────────────────────────────
# What the VybeKiit store sells: the payment provider's purchasable id for the kit
# (a Lemon Squeezy variant id by default). The checkout route passes this as the
# checkout's productId. Store infrastructure only — a buyer's app carries its own.
STORE_PRODUCT_ID=""

# ═══════════════════════════════════════════════════════════════════════════════
# FUTURE VERSIONS — present for shape only; not read until the version ships.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Mobile deploy (v2 — via the author's `launch` CLI + Expo) ─────────────────
# EXPO_TOKEN=""
