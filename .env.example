# ─────────────────────────────────────────────────────────────────────────────
# VybeKiit — single source of truth for every secret/setting.
# Copy to `.env` and fill in. NEVER commit `.env` (only this example is tracked).
# `@vybekiit/core` loads + validates these with Zod; missing/invalid keys fail loud.
# Keys are grouped by the skill that fills them. Future-version keys are marked.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL of the deployed app (used for callbacks / redirects).
APP_URL="http://localhost:3000"
# "development" | "production"
NODE_ENV="development"

# ── Live work · preference ladders (ADR-0039) ─────────────────────────────────
# One file = full multi-adapter matrix. Live work tries free-tier order, then pins
# the winner. Fill only the keys for the adapters you use; blanks are fine.
#
# Data ladder:    supabase → neon → railway
#   pin keys:     DATA_PROVIDER, DATABASE_URL, (claimable) PUBLIC_POSTGRES_CLAIM_URL,
#                 CLAIMABLE_POSTGRES_ID, companion AUTH_PROVIDER (when unset)
# Host ladder:    cloudflare → render → railway → vercel
#   pin keys:     HOSTING_PROVIDER, APP_URL, CLOUDFLARE_PROJECT_NAME | RENDER_SERVICE_ID |
#                 RAILWAY_PROJECT_ID | VERCEL_PROJECT_ID
# Payments ladder: lemon-squeezy → stripe → paypal
#   pin keys:     PAYMENTS_PROVIDER only (secrets stay in their vendor keys below; never
#                 re-emitted in public Live work JSON)
#
# Dogfood apex (maintainer Live work / dogfood custom hosts only — not buyer apps):
# Allowed pool only: yosefhayimsabag.dev | askally.io | ohadbaher.net
# Use subdomains only (live-<run>.apex). Never point throwaway deploys at the apex root.
# DOGFOOD_APEX=""
#
# CLI: vybekiit live-work data|host|payments [--mode=demo|dogfood|buyer] [--vendor=…]
#
# ── Payments · @vybekiit/payments ────────────────────────────────────────────
# Which adapter to run: "lemon-squeezy" (default) | "stripe" | "paypal".
# Live work preference ladder (ADR-0039): lemon-squeezy → stripe → paypal.
# Only fill the keys for the provider you pick; the others can stay blank.
# vybekiit live-work payments pins PAYMENTS_PROVIDER only (never prints secrets).
PAYMENTS_PROVIDER="lemon-squeezy"

# Lemon Squeezy (v1 default — Merchant of Record). Get from app.lemonsqueezy.com.
# LIVE store credentials (production). Never point these at test checkout.
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
# Signing secret for verifying LIVE webhooks (order_created / refunded).
LEMONSQUEEZY_WEBHOOK_SECRET=""
# When true, checkout creates test-mode sessions. Prefer the TEST_MODE_* keys below so
# live LEMONSQUEEZY_API_KEY / LEMONSQUEEZY_WEBHOOK_SECRET stay production-only.
LEMONSQUEEZY_TEST_MODE="false"
# TEST store credentials (local/e2e). Used only when LEMONSQUEEZY_TEST_MODE=true.
# Create a test-mode webhook with the test API key and paste the signing secret here.
LEMONSQUEEZY_TEST_MODE_API_KEY=""
LEMONSQUEEZY_TEST_MODE_WEBHOOK_SECRET=""
# Test-mode variant id (live STORE_PRODUCT_ID stays for production).
LEMONSQUEEZY_TEST_MODE_STORE_PRODUCT_ID=""

# Stripe (alternative). Get from dashboard.stripe.com.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# PayPal (alternative). Get from developer.paypal.com. PAYPAL_ENV: "sandbox" | "live".
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_ENV="sandbox"

# ── Auth · @vybekiit/auth ────────────────────────────────────────────────────
# Filled by the add-signin skill; the builder never edits these by hand.
# Which auth adapter to run: "better-auth" (default, DB-bound) | "cognito" (AWS).
# better-auth follows DATA_PROVIDER: it stores its tables in the same database your
# data uses (Postgres for Supabase, Mongo for MongoDB). DATA_PROVIDER="aws" auto-uses
# Cognito, since DynamoDB has no better-auth adapter (ADR-0003).
AUTH_PROVIDER="better-auth"
# better-auth — only read when AUTH_PROVIDER="better-auth".
# Session signing secret (generate: openssl rand -base64 32). Base URL defaults to APP_URL.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=""
# Postgres connection string better-auth opens when data is Postgres/Supabase.
# Supabase exposes it in Project Settings → Database (Mongo apps leave this blank).
DATABASE_URL=""
# AWS Cognito — only read when auth resolves to Cognito (AUTH_PROVIDER="cognito" or
# DATA_PROVIDER="aws"). Region reuses AWS_REGION below.
COGNITO_USER_POOL_ID=""
COGNITO_CLIENT_ID=""
# Google OAuth ("Sign in with Google"). Filled by `vybekiit-automate google oauth`; the
# secret is shown only once at creation, so re-run with --reset-secret to get a fresh one.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Database · @vybekiit/db ──────────────────────────────────────────────────
# Used by @vybekiit/db. Get from your Supabase project settings.
# Which data adapter to run: "supabase" (default) | "neon" | "firebase" | "mongodb" | "aws" | "railway".
# Live work preference ladder (ADR-0039): supabase → neon → railway (other adapters are explicit pin only).
# vybekiit live-work data pins DATA_PROVIDER + DATABASE_URL (+ claimable keys when used).
DATA_PROVIDER="supabase"
# Which file-storage adapter to run: "supabase" (default) | "r2" | "s3".
# Doctor provisions R2 on the default Cloudflare stack (ADR-0010).
STORAGE_PROVIDER="supabase"
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
# Server-only. Never expose to the browser / client bundle.
SUPABASE_SERVICE_ROLE_KEY=""

# Neon — only when DATA_PROVIDER="neon". Pooled connection string from Neon dashboard.
# Claimable Neon (demo / dogfood Live work — ADR-0039). Written by vybekiit live-work data
# after neon.new provision. Unclaimed DBs expire (~72h). Never commit real values.
# PUBLIC_POSTGRES_CLAIM_URL=""
# CLAIMABLE_POSTGRES_ID=""
# DATABASE_URL=""  # same key better-auth uses for Postgres
# Optional for doctor/MCP (never commit):
# NEON_API_KEY=""

# Firebase Firestore — only when DATA_PROVIDER="firebase".
# FIREBASE_PROJECT_ID=""
# FIREBASE_SERVICE_ACCOUNT_JSON=""  # inline JSON string (server-only)
# GOOGLE_APPLICATION_CREDENTIALS=""  # path to service account JSON file

# Railway Postgres — only when DATA_PROVIDER="railway" (coupled with HOSTING_PROVIDER=railway).
# DATABASE_URL=""  # Postgres connection string from Railway service variables
# RAILWAY_PROJECT_ID=""   # optional until railway link
# RAILWAY_SERVICE_ID=""   # optional service pin for deploy

# Cloudflare R2 — provisioned by doctor on HOSTING_PROVIDER=cloudflare.
R2_ACCOUNT_ID=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_URL=""

# MongoDB Atlas — only fill when DATA_PROVIDER="mongodb". Provisioned by the
# save-data/doctor skills; the builder never sets these by hand. URI is the Atlas
# SRV connection string (mongodb+srv://...); DB is the database name.
MONGODB_URI=""
MONGODB_DB=""

# AWS DynamoDB — only fill when DATA_PROVIDER="aws". Provisioned by the
# save-data/doctor skills. AWS_REGION is required; leave the access keys blank to
# use the deploy environment's default credential chain (instance role, etc.).
# AWS_DYNAMODB_TABLE_PREFIX optionally namespaces table names (e.g. "prod_").
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_DYNAMODB_TABLE_PREFIX=""
# AWS reuses these region/credential keys for S3 storage (STORAGE_PROVIDER="s3") and
# SES email (EMAIL_PROVIDER="ses"). The Amplify keys below are only read when
# HOSTING_PROVIDER="aws"; the go-live skill provisions the Amplify app and fills them.
# Branch defaults to "main".
AWS_AMPLIFY_APP_ID=""
AWS_AMPLIFY_BRANCH="main"

# ── Infra · Cloudflare (hosting, edge, domains, cron, R2, email) ─────────────
# Used at deploy time (@vybekiit/deploy) and by @vybekiit/email. From the CF dashboard.
# Which hosting adapter to run: "cloudflare" (default) | "render" | "railway" | "vercel" | "aws".
# Live work preference ladder (ADR-0039): cloudflare → render → railway → vercel (aws is explicit pin only).
# vybekiit live-work host pins HOSTING_PROVIDER + APP_URL (+ vendor project id when known).
HOSTING_PROVIDER="cloudflare"
# Which email adapter to run: "cloudflare" (default) | "ses" | "resend".
EMAIL_PROVIDER="cloudflare"
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
# Optional pin after Live work host create (Pages project name).
# CLOUDFLARE_PROJECT_NAME=""
# Deploy packages/email/worker, then set endpoint to its /send URL.
CLOUDFLARE_EMAIL_ENDPOINT=""
# Same value as `wrangler secret put EMAIL_WORKER_SECRET` on the email worker.
EMAIL_WORKER_SECRET=""
EMAIL_FROM="hello@vybekiit.com"
EMAIL_FROM_NAME="VybeKiit"

# ── Infra · Namecheap (optional — automate nameserver delegation) ────────────
# Profile → Tools → Namecheap API Access → ON; whitelist your IP (curl https://api.ipify.org).
NAMECHEAP_API_USER=""
NAMECHEAP_API_KEY=""
NAMECHEAP_CLIENT_IP=""
# NAMECHEAP_USERNAME=""   # defaults to NAMECHEAP_API_USER when unset
# NAMECHEAP_SANDBOX="0"   # set to 1 for Namecheap sandbox API

# ── Infra · GoDaddy (optional — automate nameserver delegation) ──────────────
# Create keys at https://developer.godaddy.com/keys — use OTE for testing first.
GODADDY_API_KEY=""
GODADDY_API_SECRET=""
# GODADDY_OTE="0"         # set to 1 for GoDaddy OTE (test) API

# ── Infra · Render (host ladder #2 — ADR-0039) ────────────────────────────────
# Only read when HOSTING_PROVIDER="render" or Live work hops here.
# API key: Render Dashboard → Account Settings → API Keys.
# RENDER_STATIC_REPO is a public git repo for static site create (optional; demo may skip).
# RENDER_API_KEY=""
# RENDER_SERVICE_ID=""
# RENDER_STATIC_REPO=""

# ── Infra · Vercel (opt-in hosting — ADR-0006) ───────────────────────────────
# Only read when HOSTING_PROVIDER="vercel". Token from Vercel dashboard → Settings → Tokens.
# VERCEL_ORG_ID / VERCEL_PROJECT_ID optional until go-live links the project.
VERCEL_TOKEN=""
VERCEL_ORG_ID=""
VERCEL_PROJECT_ID=""

# ── Infra · Railway (opt-in coupled stack — ADR-0017) ────────────────────────
# Set HOSTING_PROVIDER="railway" and DATA_PROVIDER="railway" together.
# Auth via `railway login` (CLI-native — no token here). Doctor runs `railway setup agent -y`.
# RAILWAY_PROJECT_ID / RAILWAY_SERVICE_ID optional until link; DATABASE_URL from Railway variables.

# ── The gate · GitHub access automation ──────────────────────────────────────
# Server-only token used by the order webhook to invite/remove buyers on the
# private repo. Needs repo + admin:org (invite) scope. Maintainer infra only.
GITHUB_GATE_TOKEN=""
GITHUB_GATE_ORG="VybeKiit"
# CSV of private template mirror repos invited on purchase (ADR-0005).
GITHUB_GATE_REPOS="web,mobile,extension"

# ── The store · apps/landing checkout ────────────────────────────────────────
# What the VybeKiit store sells: the payment provider's purchasable id for the kit
# (a Lemon Squeezy variant id by default). The checkout route passes this as the
# checkout's productId. Store infrastructure only — a buyer's app carries its own.
STORE_PRODUCT_ID=""

# ── Product analytics · apps/landing PostHog (posthog-js) ──────────────────
# Silent no-op until the project token is set. Web SDK loads in instrumentation-client.ts.
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=""   # phc_… from PostHog project settings
# NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"  # or https://eu.i.posthog.com
# Legacy kit keys (VisitorScripts / @vybekiit/analytics) — leave ANALYTICS_PROVIDER=local
# when using the posthog-js path above so events are not double-counted.
# ANALYTICS_PROVIDER=local
# POSTHOG_API_KEY=""
# POSTHOG_HOST=""

# ── Observability · apps/landing Sentry (@sentry/nextjs) ───────────────────
# Silent no-op until DSNs are set. Same DSN value is fine for both keys.
# SENTRY_DSN=""                    # server + edge (project DSN)
# NEXT_PUBLIC_SENTRY_DSN=""        # browser (same DSN)
# Source maps on `next build` (optional — CI / local secrets only):
# SENTRY_ORG="individual-kl"
# SENTRY_PROJECT="vybekiit"
# SENTRY_AUTH_TOKEN=""             # never commit

# ── Product surface (ADR-0012) ───────────────────────────────────────────────
# JOBS_PROVIDER=cloudflare          # cloudflare | trigger | qstash | local
# CLOUDFLARE_QUEUE_NAME=""
# CLOUDFLARE_CRON_SECRET=""
# ANALYTICS_PROVIDER=plausible        # plausible | posthog | local
# PLAUSIBLE_DOMAIN=""
# NOTIFICATIONS_PROVIDER=expo         # expo | twilio | email | local
# EXPO_ACCESS_TOKEN=""
# AI_PROVIDER=local                   # local | openai
# OPENAI_API_KEY=""
# SEARCH_PROVIDER=supabase            # supabase | typesense | algolia | local
# REALTIME_PROVIDER=supabase          # supabase | cloudflare-do | local
# CMS_PROVIDER=mdx                    # mdx | local
# CMS_CONTENT_DIR="content"
# CLIENT_STATE_PERSIST=on                 # on | off — client query cache persist
# CLIENT_STATE_QUERY_STALE_SECONDS=60     # seconds before refetch
# KV_PROVIDER=cloudflare              # cloudflare | upstash | local
# CLOUDFLARE_KV_NAMESPACE_ID=""
# TENANCY_PROVIDER=better-auth        # better-auth | local
# RESEND_API_KEY=""                   # when EMAIL_PROVIDER=resend

# ── Maintainer · local vibe-coder dev tools (never enable in production) ─────
# Report Mode dock + dev assistant sidebar — only load on localhost dev servers.
VYBE_ASSISTANT="cursor"
VYBE_REPORT_MODE="1"
VYBE_ASSISTANT_CHAT="1"
NEXT_PUBLIC_VYBE_ASSISTANT_CHAT_PORT="4319"

# ── Maintainer · UI registry sync (not buyer-facing) ───────────────────────
# API_KEY_21ST=""  # 21st.dev team API key — https://21st.dev/team/api-keys

# ── The store · apps/landing checkout ────────────────────────────────────────
# What the VybeKiit store sells: the payment provider's purchasable id for the kit
# (a Lemon Squeezy variant id by default). The checkout route passes this as the
# checkout's productId. Store infrastructure only — a buyer's app carries its own.
STORE_PRODUCT_ID=""

# ═══════════════════════════════════════════════════════════════════════════════
# FUTURE VERSIONS — present for shape only; not read until the version ships.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Mobile deploy (v2 — via the author's `launch` CLI + Expo) ─────────────────
# EXPO_TOKEN=""
