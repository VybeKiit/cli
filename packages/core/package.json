{
  "name": "@vybekiit/core",
  "version": "0.3.0",
  "description": "VybeKiit core — env + Effect Schema-validated config (the single source of truth), a Result type, and shared constants.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "require": "./dist/config.cjs"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js",
      "require": "./dist/constants.cjs"
    },
    "./effectInterop": {
      "types": "./dist/effectInterop.d.ts",
      "import": "./dist/effectInterop.js",
      "require": "./dist/effectInterop.cjs"
    },
    "./envSource": {
      "types": "./dist/envSource.d.ts",
      "import": "./dist/envSource.js",
      "require": "./dist/envSource.cjs"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "import": "./dist/logger.js",
      "require": "./dist/logger.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./providerDispatch": {
      "types": "./dist/providerDispatch.d.ts",
      "import": "./dist/providerDispatch.js",
      "require": "./dist/providerDispatch.cjs"
    },
    "./result": {
      "types": "./dist/result.d.ts",
      "import": "./dist/result.js",
      "require": "./dist/result.cjs"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js",
      "require": "./dist/http/index.cjs"
    },
    "./http/client": {
      "types": "./dist/http/client/index.d.ts",
      "import": "./dist/http/client/index.js",
      "require": "./dist/http/client/index.cjs"
    },
    "./http/express": {
      "types": "./dist/http/express.d.ts",
      "import": "./dist/http/express.js",
      "require": "./dist/http/express.cjs"
    },
    "./http/next": {
      "types": "./dist/http/next.d.ts",
      "import": "./dist/http/next.js",
      "require": "./dist/http/next.cjs"
    },
    "./http/outcomes": {
      "types": "./dist/http/outcomes.d.ts",
      "import": "./dist/http/outcomes.js",
      "require": "./dist/http/outcomes.cjs"
    },
    "./http/responseSchemas": {
      "types": "./dist/http/responseSchemas.d.ts",
      "import": "./dist/http/responseSchemas.js",
      "require": "./dist/http/responseSchemas.cjs"
    },
    "./observability": {
      "types": "./dist/observability/index.d.ts",
      "import": "./dist/observability/index.js",
      "require": "./dist/observability/index.cjs"
    },
    "./observability/types": {
      "types": "./dist/observability/types.d.ts",
      "import": "./dist/observability/types.js",
      "require": "./dist/observability/types.cjs"
    },
    "./security": {
      "types": "./dist/security/index.d.ts",
      "import": "./dist/security/index.js",
      "require": "./dist/security/index.cjs"
    },
    "./security/express": {
      "types": "./dist/security/express.d.ts",
      "import": "./dist/security/express.js",
      "require": "./dist/security/express.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "effect": "catalog:",
    "@sentry/node": "^9.5.0"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@types/express": "^5.0.0",
    "express": "^4.21.2"
  },
  "private": true,
  "peerDependencies": {
    "express": ">=4"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  }
}
