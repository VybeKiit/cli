{
  "name": "@vybekiit/db",
  "version": "0.3.0",
  "description": "Typed Supabase data client for VybeKiit — server-side client factory and a health check. No UI.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./providers/postgres/*": {
      "types": "./dist/providers/postgres/*.d.ts",
      "import": "./dist/providers/postgres/*.js",
      "require": "./dist/providers/postgres/*.cjs"
    },
    "./providers/*": {
      "types": "./dist/providers/*/index.d.ts",
      "import": "./dist/providers/*/index.js",
      "require": "./dist/providers/*/index.cjs"
    },
    "./presets": {
      "types": "./dist/presets/index.d.ts",
      "import": "./dist/presets/index.js",
      "require": "./dist/presets/index.cjs"
    },
    "./presets/*": {
      "types": "./dist/presets/*.d.ts",
      "import": "./dist/presets/*.js",
      "require": "./dist/presets/*.cjs"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.cjs"
    }
  },
  "files": [
    "dist",
    "presets"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1075.0",
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/lib-dynamodb": "^3.1075.0",
    "@neondatabase/serverless": "^0.10.4",
    "@supabase/supabase-js": "^2.47.10",
    "@vybekiit/core": "workspace:*",
    "effect": "catalog:",
    "firebase-admin": "^13.0.2",
    "mongodb": "^7.4.0"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@effect/vitest": "catalog:"
  },
  "private": true,
  "vybekiit": {
    "kind": "concern"
  }
}
