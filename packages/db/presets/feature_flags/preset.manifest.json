{
  "id": "feature_flags",
  "version": 1,
  "description": "Feature flags with per-user overrides.",
  "entities": [
    {
      "name": "feature_flags",
      "columns": [
        { "name": "id", "type": "uuid", "required": true, "default": "gen_random_uuid()" },
        { "name": "key", "type": "text", "required": true, "unique": true },
        { "name": "enabled", "type": "boolean", "required": true, "default": "false" },
        { "name": "description", "type": "text" },
        { "name": "created_at", "type": "timestamptz", "required": true, "default": "now()" }
      ]
    },
    {
      "name": "feature_flag_overrides",
      "columns": [
        { "name": "id", "type": "uuid", "required": true, "default": "gen_random_uuid()" },
        {
          "name": "flag_key",
          "type": "text",
          "required": true,
          "references": { "table": "feature_flags", "column": "key" }
        },
        { "name": "user_id", "type": "text", "required": true },
        { "name": "enabled", "type": "boolean", "required": true },
        { "name": "created_at", "type": "timestamptz", "required": true, "default": "now()" }
      ]
    }
  ],
  "relations": [
    {
      "from": "feature_flag_overrides",
      "to": "feature_flags",
      "foreignKey": "flag_key",
      "type": "many"
    }
  ],
  "indexes": [
    {
      "table": "feature_flags",
      "columns": ["key"],
      "unique": true,
      "reason": "lookup flag by stable key"
    },
    {
      "table": "feature_flag_overrides",
      "columns": ["user_id", "flag_key"],
      "unique": true,
      "reason": "one override per user per flag"
    }
  ],
  "rls": "service-role-only",
  "capabilities": [],
  "skills": [],
  "packages": ["@vybekiit/core"],
  "providers": {
    "supabase": "stable",
    "neon": "stable",
    "railway": "stable",
    "mongodb": "stable",
    "firebase": "stable",
    "aws": "stable"
  }
}
