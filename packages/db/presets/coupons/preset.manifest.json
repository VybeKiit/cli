{
  "id": "coupons",
  "version": 1,
  "description": "Discount codes and redemptions for checkout.",
  "entities": [
    {
      "name": "coupons",
      "columns": [
        { "name": "id", "type": "uuid", "required": true, "default": "gen_random_uuid()" },
        { "name": "code", "type": "text", "required": true, "unique": true },
        { "name": "percent_off", "type": "numeric" },
        { "name": "amount_off_cents", "type": "numeric" },
        { "name": "currency", "type": "text" },
        { "name": "max_redemptions", "type": "numeric" },
        { "name": "redeem_by", "type": "timestamptz" },
        { "name": "active", "type": "boolean", "required": true, "default": "true" },
        { "name": "created_at", "type": "timestamptz", "required": true, "default": "now()" }
      ]
    },
    {
      "name": "coupon_redemptions",
      "columns": [
        { "name": "id", "type": "uuid", "required": true, "default": "gen_random_uuid()" },
        {
          "name": "coupon_id",
          "type": "uuid",
          "required": true,
          "references": { "table": "coupons", "column": "id" }
        },
        { "name": "user_id", "type": "text" },
        { "name": "order_id", "type": "text" },
        { "name": "redeemed_at", "type": "timestamptz", "required": true, "default": "now()" }
      ]
    }
  ],
  "relations": [
    {
      "from": "coupon_redemptions",
      "to": "coupons",
      "foreignKey": "coupon_id",
      "type": "many"
    }
  ],
  "indexes": [
    {
      "table": "coupons",
      "columns": ["code"],
      "unique": true,
      "reason": "lookup discount by checkout code"
    },
    {
      "table": "coupons",
      "columns": ["active"],
      "reason": "list active codes for admin and validation"
    },
    {
      "table": "coupon_redemptions",
      "columns": ["coupon_id"],
      "reason": "count redemptions against max_redemptions"
    },
    {
      "table": "coupon_redemptions",
      "columns": ["user_id", "coupon_id"],
      "reason": "check whether a buyer already redeemed a code"
    }
  ],
  "rls": "service-role-only",
  "capabilities": ["upsert"],
  "skills": ["setup-payments"],
  "packages": ["@vybekiit/payments"],
  "providers": {
    "supabase": "stable",
    "neon": "stable",
    "railway": "stable",
    "mongodb": "stable",
    "firebase": "stable",
    "aws": "stable"
  }
}
