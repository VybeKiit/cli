{
  "id": "customers",
  "version": 1,
  "description": "CRM customers and notes for customer list and detail pages.",
  "entities": [
    {
      "name": "customers",
      "columns": [
        { "name": "id", "type": "uuid", "required": true, "default": "gen_random_uuid()" },
        { "name": "user_id", "type": "text", "required": true },
        { "name": "email", "type": "text" },
        { "name": "name", "type": "text", "required": true },
        { "name": "company", "type": "text" },
        { "name": "status", "type": "text", "required": true, "default": "'active'" },
        { "name": "phone", "type": "text" },
        { "name": "metadata", "type": "jsonb", "required": true, "default": "'{}'::jsonb" },
        { "name": "created_at", "type": "timestamptz", "required": true, "default": "now()" },
        { "name": "updated_at", "type": "timestamptz", "required": true, "default": "now()" }
      ]
    },
    {
      "name": "customer_notes",
      "columns": [
        { "name": "id", "type": "uuid", "required": true, "default": "gen_random_uuid()" },
        {
          "name": "customer_id",
          "type": "uuid",
          "required": true,
          "references": { "table": "customers", "column": "id" }
        },
        { "name": "author_user_id", "type": "text", "required": true },
        { "name": "body", "type": "text", "required": true },
        { "name": "created_at", "type": "timestamptz", "required": true, "default": "now()" }
      ]
    }
  ],
  "relations": [
    {
      "from": "customer_notes",
      "to": "customers",
      "foreignKey": "customer_id",
      "type": "many"
    }
  ],
  "indexes": [
    {
      "table": "customers",
      "columns": ["user_id", "status"],
      "reason": "list customers by owner and status"
    },
    {
      "table": "customers",
      "columns": ["email"],
      "reason": "lookup customer by email"
    },
    {
      "table": "customer_notes",
      "columns": ["customer_id", "created_at"],
      "reason": "load customer notes in chronological order"
    },
    {
      "table": "customers",
      "columns": ["user_id", "email"],
      "unique": true,
      "where": "email is not null",
      "reason": "one customer email per owner when email is set"
    }
  ],
  "rls": "user-owned",
  "rlsColumn": "user_id",
  "capabilities": ["upsert"],
  "skills": [],
  "packages": ["@vybekiit/db"],
  "providers": {
    "supabase": "stable",
    "neon": "stable",
    "railway": "stable",
    "mongodb": "stable",
    "firebase": "stable",
    "aws": "stable"
  }
}
