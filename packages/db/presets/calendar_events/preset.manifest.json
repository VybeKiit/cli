{
  "id": "calendar_events",
  "version": 1,
  "description": "Calendar events for scheduling pages.",
  "entities": [
    {
      "name": "calendar_events",
      "columns": [
        { "name": "id", "type": "uuid", "required": true, "default": "gen_random_uuid()" },
        { "name": "user_id", "type": "text", "required": true },
        { "name": "title", "type": "text", "required": true },
        { "name": "description", "type": "text" },
        { "name": "starts_at", "type": "timestamptz", "required": true },
        { "name": "ends_at", "type": "timestamptz", "required": true },
        { "name": "all_day", "type": "boolean", "required": true, "default": "false" },
        { "name": "location", "type": "text" },
        { "name": "metadata", "type": "jsonb", "required": true, "default": "'{}'::jsonb" },
        { "name": "created_at", "type": "timestamptz", "required": true, "default": "now()" },
        { "name": "updated_at", "type": "timestamptz", "required": true, "default": "now()" }
      ]
    },
    {
      "name": "calendar_event_attendees",
      "columns": [
        { "name": "id", "type": "uuid", "required": true, "default": "gen_random_uuid()" },
        {
          "name": "event_id",
          "type": "uuid",
          "required": true,
          "references": { "table": "calendar_events", "column": "id" }
        },
        { "name": "email", "type": "text", "required": true },
        { "name": "name", "type": "text" },
        { "name": "status", "type": "text", "default": "'invited'" },
        { "name": "created_at", "type": "timestamptz", "required": true, "default": "now()" }
      ]
    }
  ],
  "relations": [
    {
      "from": "calendar_event_attendees",
      "to": "calendar_events",
      "foreignKey": "event_id",
      "type": "many"
    }
  ],
  "indexes": [
    {
      "table": "calendar_events",
      "columns": ["user_id", "starts_at"],
      "reason": "list a user's events by start time"
    },
    {
      "table": "calendar_events",
      "columns": ["starts_at", "ends_at"],
      "reason": "range queries for calendar views"
    },
    {
      "table": "calendar_event_attendees",
      "columns": ["event_id"],
      "reason": "load attendees for an event"
    },
    {
      "table": "calendar_event_attendees",
      "columns": ["email"],
      "reason": "find events by attendee email"
    }
  ],
  "rls": "user-owned",
  "rlsColumn": "user_id",
  "capabilities": ["upsert"],
  "skills": [],
  "packages": ["@vybekiit/db"],
  "providers": {
    "supabase": "stable",
    "neon": "stable",
    "railway": "stable",
    "mongodb": "stable",
    "firebase": "stable",
    "aws": "stable"
  }
}
