{
  "id": "orders",
  "version": 1,
  "description": "Payment orders for fulfillment and refund tracking.",
  "entities": [
    {
      "name": "orders",
      "columns": [
        { "name": "id", "type": "uuid", "required": true, "default": "gen_random_uuid()" },
        { "name": "order_id", "type": "text", "required": true, "unique": true },
        { "name": "email", "type": "text" },
        { "name": "github_username", "type": "text" },
        { "name": "refunded", "type": "boolean", "required": true, "default": "false" },
        { "name": "license_key", "type": "text" },
        { "name": "activated_at", "type": "timestamptz" },
        { "name": "revoked", "type": "boolean", "required": true, "default": "false" },
        { "name": "created_at", "type": "timestamptz", "required": true, "default": "now()" },
        { "name": "updated_at", "type": "timestamptz", "required": true, "default": "now()" }
      ]
    }
  ],
  "indexes": [
    {
      "table": "orders",
      "columns": ["order_id"],
      "unique": true,
      "reason": "upsert conflict key for payment webhooks"
    },
    {
      "table": "orders",
      "columns": ["email"],
      "reason": "buyer lookup in fulfillment"
    },
    {
      "table": "orders",
      "columns": ["github_username"],
      "reason": "GitHub gate lookup after checkout"
    },
    {
      "table": "orders",
      "columns": ["created_at"],
      "reason": "admin order list sorted by date"
    },
    {
      "table": "orders",
      "columns": ["license_key"],
      "unique": true,
      "where": "license_key is not null",
      "reason": "unique license activation keys"
    }
  ],
  "rls": "service-role-only",
  "capabilities": ["upsert"],
  "skills": ["setup-payments"],
  "packages": ["@vybekiit/payments"],
  "providers": {
    "supabase": "stable",
    "neon": "stable",
    "railway": "stable",
    "mongodb": "stable",
    "firebase": "stable",
    "aws": "stable"
  }
}
