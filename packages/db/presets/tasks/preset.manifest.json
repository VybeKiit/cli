{
  "id": "tasks",
  "version": 1,
  "description": "Task lists and tasks for productivity pages.",
  "entities": [
    {
      "name": "task_lists",
      "columns": [
        { "name": "id", "type": "uuid", "required": true, "default": "gen_random_uuid()" },
        { "name": "user_id", "type": "text", "required": true },
        { "name": "name", "type": "text", "required": true },
        { "name": "position", "type": "numeric", "required": true, "default": "0" },
        { "name": "created_at", "type": "timestamptz", "required": true, "default": "now()" }
      ]
    },
    {
      "name": "tasks",
      "columns": [
        { "name": "id", "type": "uuid", "required": true, "default": "gen_random_uuid()" },
        { "name": "user_id", "type": "text", "required": true },
        {
          "name": "list_id",
          "type": "uuid",
          "required": true,
          "references": { "table": "task_lists", "column": "id" }
        },
        { "name": "title", "type": "text", "required": true },
        { "name": "description", "type": "text" },
        { "name": "status", "type": "text", "required": true, "default": "'todo'" },
        { "name": "priority", "type": "text", "default": "'normal'" },
        { "name": "due_at", "type": "timestamptz" },
        { "name": "assignee_user_id", "type": "text" },
        { "name": "position", "type": "numeric", "required": true, "default": "0" },
        { "name": "created_at", "type": "timestamptz", "required": true, "default": "now()" },
        { "name": "updated_at", "type": "timestamptz", "required": true, "default": "now()" }
      ]
    }
  ],
  "relations": [
    {
      "from": "tasks",
      "to": "task_lists",
      "foreignKey": "list_id",
      "type": "many"
    }
  ],
  "indexes": [
    {
      "table": "tasks",
      "columns": ["user_id", "list_id"],
      "reason": "list tasks for a user within a list"
    },
    {
      "table": "tasks",
      "columns": ["user_id", "status"],
      "reason": "filter user tasks by status"
    },
    {
      "table": "tasks",
      "columns": ["list_id", "position"],
      "reason": "order tasks within a list"
    },
    {
      "table": "tasks",
      "columns": ["due_at"],
      "where": "due_at is not null",
      "reason": "upcoming due dates without scanning nulls"
    }
  ],
  "rls": "user-owned",
  "rlsColumn": "user_id",
  "capabilities": ["upsert"],
  "skills": [],
  "packages": ["@vybekiit/db"],
  "providers": {
    "supabase": "stable",
    "neon": "stable",
    "railway": "stable",
    "mongodb": "stable",
    "firebase": "stable",
    "aws": "stable"
  }
}
