{
  "id": "search_documents",
  "version": 1,
  "description": "Full-text searchable documents for in-app search.",
  "entities": [
    {
      "name": "search_documents",
      "columns": [
        { "name": "id", "type": "text", "required": true },
        { "name": "user_id", "type": "text" },
        { "name": "content", "type": "text", "required": true },
        {
          "name": "search_vector",
          "type": "text",
          "generated": "to_tsvector('english', coalesce(content, ''))"
        },
        { "name": "created_at", "type": "timestamptz", "required": true, "default": "now()" }
      ]
    }
  ],
  "indexes": [
    {
      "table": "search_documents",
      "columns": ["search_vector"],
      "method": "gin",
      "reason": "full-text search queries via tsvector"
    },
    {
      "table": "search_documents",
      "columns": ["user_id"],
      "reason": "scoped search for user-owned documents"
    }
  ],
  "rls": "user-owned",
  "rlsColumn": "user_id",
  "capabilities": ["fullTextSearch"],
  "skills": ["add-search"],
  "packages": ["@vybekiit/search"],
  "providers": {
    "supabase": "stable",
    "neon": "stable",
    "railway": "stable",
    "mongodb": "planned",
    "firebase": "planned",
    "aws": "planned"
  }
}
