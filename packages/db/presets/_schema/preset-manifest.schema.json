{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vybekiit.dev/schemas/preset-manifest.json",
  "title": "VybeKiit DB Preset Manifest",
  "type": "object",
  "required": ["id", "version", "entities", "indexes", "rls", "capabilities", "skills", "packages"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string" },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "columns"],
        "properties": {
          "name": { "type": "string" },
          "primaryKey": { "type": "string" },
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string" },
                "type": {
                  "enum": ["text", "uuid", "boolean", "timestamptz", "jsonb", "numeric", "vector"]
                },
                "required": { "type": "boolean" },
                "unique": { "type": "boolean" },
                "default": { "type": "string" },
                "references": {
                  "type": "object",
                  "required": ["table", "column"],
                  "properties": {
                    "table": { "type": "string" },
                    "column": { "type": "string" }
                  }
                },
                "generated": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "foreignKey", "type"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "foreignKey": { "type": "string" },
          "type": { "enum": ["one", "many"] }
        }
      }
    },
    "indexes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["table", "columns", "reason"],
        "properties": {
          "table": { "type": "string" },
          "columns": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "unique": { "type": "boolean" },
          "method": { "enum": ["btree", "gin", "hnsw", "ivfflat"] },
          "where": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "extensions": { "type": "array", "items": { "type": "string" } },
    "rls": {
      "enum": [
        "service-role-only",
        "user-owned",
        "org-owned",
        "public-read-authenticated-write",
        "none"
      ]
    },
    "rlsColumn": { "type": "string" },
    "orgColumn": { "type": "string" },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "upsert",
          "idempotentInsert",
          "vectorSearch",
          "fullTextSearch",
          "bulkInsert",
          "transaction"
        ]
      }
    },
    "skills": { "type": "array", "items": { "type": "string" } },
    "packages": { "type": "array", "items": { "type": "string" } },
    "providers": { "type": "object" },
    "helpers": { "type": "array", "items": { "type": "string" } }
  }
}
