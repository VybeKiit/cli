{
  "id": "audit_log",
  "version": 1,
  "description": "Append-only audit trail for security-sensitive actions.",
  "entities": [
    {
      "name": "audit_log",
      "columns": [
        { "name": "id", "type": "uuid", "required": true, "default": "gen_random_uuid()" },
        { "name": "actor_id", "type": "text" },
        { "name": "action", "type": "text", "required": true },
        { "name": "resource_type", "type": "text" },
        { "name": "resource_id", "type": "text" },
        { "name": "metadata", "type": "jsonb", "required": true, "default": "'{}'::jsonb" },
        { "name": "created_at", "type": "timestamptz", "required": true, "default": "now()" }
      ]
    }
  ],
  "indexes": [
    {
      "table": "audit_log",
      "columns": ["actor_id", "created_at"],
      "reason": "audit timeline per actor"
    },
    {
      "table": "audit_log",
      "columns": ["resource_type", "resource_id"],
      "reason": "lookup audit entries for a resource"
    }
  ],
  "rls": "service-role-only",
  "capabilities": ["bulkInsert"],
  "skills": ["harden"],
  "packages": ["@vybekiit/core/security"],
  "providers": {
    "supabase": "stable",
    "neon": "stable",
    "railway": "stable",
    "mongodb": "planned",
    "firebase": "planned",
    "aws": "planned"
  }
}
