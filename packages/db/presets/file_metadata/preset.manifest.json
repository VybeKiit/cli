{
  "id": "file_metadata",
  "version": 1,
  "description": "Metadata for user-uploaded files in object storage.",
  "entities": [
    {
      "name": "file_metadata",
      "columns": [
        { "name": "id", "type": "uuid", "required": true, "default": "gen_random_uuid()" },
        { "name": "user_id", "type": "text", "required": true },
        { "name": "bucket", "type": "text", "required": true },
        { "name": "key", "type": "text", "required": true },
        { "name": "content_type", "type": "text" },
        { "name": "size_bytes", "type": "numeric" },
        { "name": "created_at", "type": "timestamptz", "required": true, "default": "now()" }
      ]
    }
  ],
  "indexes": [
    {
      "table": "file_metadata",
      "columns": ["bucket", "key"],
      "unique": true,
      "reason": "one metadata row per stored object"
    },
    {
      "table": "file_metadata",
      "columns": ["user_id"],
      "reason": "list files uploaded by a user"
    }
  ],
  "rls": "user-owned",
  "rlsColumn": "user_id",
  "capabilities": ["upsert"],
  "skills": ["add-files"],
  "packages": ["@vybekiit/db"],
  "providers": {
    "supabase": "stable",
    "neon": "stable",
    "railway": "stable",
    "mongodb": "planned",
    "firebase": "planned",
    "aws": "planned"
  }
}
