{
  "id": "webhook_events",
  "version": 1,
  "description": "Idempotent webhook audit log for payment and integration events.",
  "entities": [
    {
      "name": "webhook_events",
      "columns": [
        { "name": "id", "type": "uuid", "required": true, "default": "gen_random_uuid()" },
        { "name": "event_id", "type": "text", "required": true, "unique": true },
        { "name": "provider", "type": "text", "required": true },
        { "name": "event_type", "type": "text" },
        { "name": "payload", "type": "jsonb", "required": true, "default": "'{}'::jsonb" },
        { "name": "received_at", "type": "timestamptz", "required": true, "default": "now()" }
      ]
    }
  ],
  "indexes": [
    {
      "table": "webhook_events",
      "columns": ["event_id"],
      "unique": true,
      "reason": "idempotent webhook deduplication"
    },
    {
      "table": "webhook_events",
      "columns": ["provider", "received_at"],
      "reason": "provider event timeline queries"
    }
  ],
  "rls": "service-role-only",
  "capabilities": ["idempotentInsert", "upsert"],
  "skills": ["setup-payments"],
  "packages": ["@vybekiit/payments"],
  "providers": {
    "supabase": "stable",
    "neon": "stable",
    "railway": "stable",
    "mongodb": "planned",
    "firebase": "planned",
    "aws": "planned"
  }
}
