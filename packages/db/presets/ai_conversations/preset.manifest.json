{
  "id": "ai_conversations",
  "version": 1,
  "description": "AI chat history with messages linked to conversations.",
  "entities": [
    {
      "name": "ai_conversations",
      "columns": [
        { "name": "id", "type": "text", "required": true },
        { "name": "user_id", "type": "text", "required": true },
        { "name": "title", "type": "text" },
        { "name": "created_at", "type": "timestamptz", "required": true, "default": "now()" },
        { "name": "updated_at", "type": "timestamptz", "required": true, "default": "now()" }
      ]
    },
    {
      "name": "ai_messages",
      "columns": [
        { "name": "id", "type": "text", "required": true },
        {
          "name": "conversation_id",
          "type": "text",
          "required": true,
          "references": { "table": "ai_conversations", "column": "id" }
        },
        { "name": "role", "type": "text", "required": true },
        { "name": "content", "type": "text", "required": true },
        { "name": "created_at", "type": "timestamptz", "required": true, "default": "now()" }
      ]
    }
  ],
  "relations": [
    {
      "from": "ai_messages",
      "to": "ai_conversations",
      "foreignKey": "conversation_id",
      "type": "many"
    }
  ],
  "indexes": [
    {
      "table": "ai_messages",
      "columns": ["conversation_id", "created_at"],
      "reason": "load conversation messages in order"
    },
    {
      "table": "ai_conversations",
      "columns": ["user_id", "updated_at"],
      "reason": "list user conversations by recency"
    }
  ],
  "rls": "user-owned",
  "rlsColumn": "user_id",
  "capabilities": ["bulkInsert"],
  "skills": ["add-ai"],
  "packages": ["@vybekiit/ai"],
  "providers": {
    "supabase": "stable",
    "neon": "stable",
    "railway": "stable",
    "mongodb": "planned",
    "firebase": "planned",
    "aws": "planned"
  }
}
