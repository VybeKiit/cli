{
  "id": "products",
  "version": 1,
  "description": "Product catalog for ecommerce grids and detail pages.",
  "entities": [
    {
      "name": "products",
      "columns": [
        { "name": "id", "type": "uuid", "required": true, "default": "gen_random_uuid()" },
        { "name": "user_id", "type": "text", "required": true },
        { "name": "name", "type": "text", "required": true },
        { "name": "slug", "type": "text", "required": true },
        { "name": "description", "type": "text" },
        { "name": "status", "type": "text", "required": true, "default": "'draft'" },
        { "name": "price_cents", "type": "numeric", "required": true, "default": "0" },
        { "name": "currency", "type": "text", "required": true, "default": "'usd'" },
        { "name": "image_url", "type": "text" },
        { "name": "metadata", "type": "jsonb", "default": "'{}'" },
        { "name": "created_at", "type": "timestamptz", "required": true, "default": "now()" },
        { "name": "updated_at", "type": "timestamptz", "required": true, "default": "now()" }
      ]
    },
    {
      "name": "product_variants",
      "columns": [
        { "name": "id", "type": "uuid", "required": true, "default": "gen_random_uuid()" },
        {
          "name": "product_id",
          "type": "uuid",
          "required": true,
          "references": { "table": "products", "column": "id" }
        },
        { "name": "name", "type": "text", "required": true },
        { "name": "sku", "type": "text" },
        { "name": "price_cents", "type": "numeric", "required": true },
        { "name": "stock", "type": "numeric" },
        { "name": "attributes", "type": "jsonb", "default": "'{}'" },
        { "name": "created_at", "type": "timestamptz", "required": true, "default": "now()" }
      ]
    }
  ],
  "relations": [
    {
      "from": "product_variants",
      "to": "products",
      "foreignKey": "product_id",
      "type": "many"
    }
  ],
  "indexes": [
    {
      "table": "products",
      "columns": ["user_id", "slug"],
      "unique": true,
      "reason": "one product slug per owner for storefront URLs"
    },
    {
      "table": "products",
      "columns": ["user_id", "status"],
      "reason": "list catalog by owner and publish status"
    },
    {
      "table": "product_variants",
      "columns": ["product_id"],
      "reason": "list variants for a product detail page"
    },
    {
      "table": "product_variants",
      "columns": ["sku"],
      "unique": true,
      "where": "sku is not null",
      "reason": "unique SKU when set for inventory lookup"
    }
  ],
  "rls": "user-owned",
  "rlsColumn": "user_id",
  "capabilities": ["upsert"],
  "skills": [],
  "packages": ["@vybekiit/db"],
  "providers": {
    "supabase": "stable",
    "neon": "stable",
    "railway": "stable",
    "mongodb": "stable",
    "firebase": "stable",
    "aws": "stable"
  }
}
