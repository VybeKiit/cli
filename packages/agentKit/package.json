{
  "name": "@vybekiit/agent-kit",
  "version": "0.3.0",
  "description": "Shared agent-layer source of truth for VybeKiit — the buyer-skill contract, the tool-jargon → plain-language vocabulary, and the kit-update planner. Template-specific skills stay embedded in each template.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vybekiit/core": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "private": true,
  "vybekiit": {
    "kind": "tooling"
  }
}
