{
  "name": "@vybekiit/auth",
  "version": "0.3.0",
  "description": "Headless auth for VybeKiit — one AuthProvider interface: Supabase Auth (default), better-auth (Postgres/Mongo), and Cognito (AWS), returned as an Effect. No UI.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js",
      "require": "./dist/http/index.cjs"
    },
    "./http/*": {
      "types": "./dist/http/*.d.ts",
      "import": "./dist/http/*.js",
      "require": "./dist/http/*.cjs"
    },
    "./http/next": {
      "types": "./dist/http/next.d.ts",
      "import": "./dist/http/next.js",
      "require": "./dist/http/next.cjs"
    },
    "./http/express": {
      "types": "./dist/http/express.d.ts",
      "import": "./dist/http/express.js",
      "require": "./dist/http/express.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./providers/*": {
      "types": "./dist/providers/*.d.ts",
      "import": "./dist/providers/*.js",
      "require": "./dist/providers/*.cjs"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1075.0",
    "@supabase/supabase-js": "^2.47.10",
    "@vybekiit/core": "workspace:*",
    "better-auth": "^1.6.22",
    "effect": "3.21.4",
    "mongodb": "^7.4.0",
    "pg": "^8.13.1"
  },
  "peerDependencies": {
    "express": ">=4"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/pg": "^8.11.10",
    "express": "^4.21.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  },
  "private": true
}
