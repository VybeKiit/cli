{
  "name": "@vybekiit/client-state",
  "version": "0.3.0",
  "description": "Unified client cache and UI prefs for VybeKiit web, mobile, and extension templates — TanStack Query + Zustand/MMKV via resolveClientState().",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "require": "./dist/config.cjs"
    },
    "./mobile": {
      "types": "./dist/mobile/index.d.ts",
      "import": "./dist/mobile/index.js",
      "require": "./dist/mobile/index.cjs"
    },
    "./query/client": {
      "types": "./dist/query/client.d.ts",
      "import": "./dist/query/client.js",
      "require": "./dist/query/client.cjs"
    },
    "./queryKeys": {
      "types": "./dist/queryKeys.d.ts",
      "import": "./dist/queryKeys.js",
      "require": "./dist/queryKeys.cjs"
    },
    "./resolve": {
      "types": "./dist/resolve.d.ts",
      "import": "./dist/resolve.js",
      "require": "./dist/resolve.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js",
      "require": "./dist/web/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/query-async-storage-persister": "^5.101.1",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-query-persist-client": "^5.101.1",
    "@vybekiit/core": "workspace:*",
    "effect": "catalog:",
    "zustand": "^5.0.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native-mmkv": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-mmkv": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "react": "^19.0.0",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "private": true,
  "vybekiit": {
    "kind": "concern"
  }
}
