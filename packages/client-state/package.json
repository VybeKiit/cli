{
  "name": "@vybekiit/client-state",
  "version": "0.3.0",
  "description": "Unified client cache and UI prefs for VybeKiit web, mobile, and extension templates — TanStack Query + Zustand/MMKV via resolveClientState().",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./mobile": {
      "types": "./dist/mobile/index.d.ts",
      "import": "./dist/mobile/index.js",
      "require": "./dist/mobile/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/query-async-storage-persister": "^5.101.1",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-query-persist-client": "^5.101.1",
    "@vybekiit/core": "workspace:*",
    "zustand": "^5.0.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native-mmkv": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-mmkv": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "react": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
