{
  "name": "@vybekiit/i18n",
  "version": "0.3.0",
  "description": "Headless locale resolution and message catalogs for VybeKiit.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./locale-rules": {
      "types": "./dist/locale-rules.d.ts",
      "import": "./dist/locale-rules.js",
      "require": "./dist/locale-rules.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vybekiit/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
