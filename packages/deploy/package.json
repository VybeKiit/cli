{
  "name": "@vybekiit/deploy",
  "version": "0.3.0",
  "private": true,
  "vybekiit": {
    "kind": "tooling"
  },
  "description": "Headless, provider-agnostic hosting for VybeKiit — one Hosting interface with a Cloudflare adapter (deploy + status). No UI. Private maintainer/CLI tooling (ADR-0025).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./resolve": {
      "types": "./dist/resolve.d.ts",
      "import": "./dist/resolve.js",
      "require": "./dist/resolve.cjs"
    },
    "./deployEffect": {
      "types": "./dist/deployEffect.d.ts",
      "import": "./dist/deployEffect.js",
      "require": "./dist/deployEffect.cjs"
    },
    "./cloudflare/*": {
      "types": "./dist/cloudflare/*.d.ts",
      "import": "./dist/cloudflare/*.js",
      "require": "./dist/cloudflare/*.cjs"
    },
    "./providers/*": {
      "types": "./dist/providers/*/index.d.ts",
      "import": "./dist/providers/*/index.js",
      "require": "./dist/providers/*/index.cjs"
    },
    "./registrar": {
      "types": "./dist/registrar/index.d.ts",
      "import": "./dist/registrar/index.js",
      "require": "./dist/registrar/index.cjs"
    },
    "./registrar/*": {
      "types": "./dist/registrar/*.d.ts",
      "import": "./dist/registrar/*.js",
      "require": "./dist/registrar/*.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-amplify": "^3.1075.0",
    "@vybekiit/core": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
