{
  "name": "@vybekiit/deploy",
  "version": "0.5.0",
  "private": true,
  "vybekiit": {
    "kind": "tooling"
  },
  "description": "Headless, provider-agnostic hosting for VybeKiit — one Hosting interface with a Cloudflare adapter (deploy + status). No UI. Private maintainer/CLI tooling (ADR-0025).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./deployEffect": {
      "types": "./dist/deployEffect.d.ts",
      "import": "./dist/deployEffect.js",
      "require": "./dist/deployEffect.cjs"
    },
    "./liveWork/githubPagesProvision": {
      "types": "./dist/liveWork/githubPagesProvision.d.ts",
      "import": "./dist/liveWork/githubPagesProvision.js",
      "require": "./dist/liveWork/githubPagesProvision.cjs"
    },
    "./providers/aws": {
      "types": "./dist/providers/aws/index.d.ts",
      "import": "./dist/providers/aws/index.js",
      "require": "./dist/providers/aws/index.cjs"
    },
    "./providers/cloudflare": {
      "types": "./dist/providers/cloudflare/index.d.ts",
      "import": "./dist/providers/cloudflare/index.js",
      "require": "./dist/providers/cloudflare/index.cjs"
    },
    "./providers/githubPages": {
      "types": "./dist/providers/githubPages/index.d.ts",
      "import": "./dist/providers/githubPages/index.js",
      "require": "./dist/providers/githubPages/index.cjs"
    },
    "./providers/railway": {
      "types": "./dist/providers/railway/index.d.ts",
      "import": "./dist/providers/railway/index.js",
      "require": "./dist/providers/railway/index.cjs"
    },
    "./providers/vercel": {
      "types": "./dist/providers/vercel/index.d.ts",
      "import": "./dist/providers/vercel/index.js",
      "require": "./dist/providers/vercel/index.cjs"
    },
    "./registrar/godaddy": {
      "types": "./dist/registrar/godaddy.d.ts",
      "import": "./dist/registrar/godaddy.js",
      "require": "./dist/registrar/godaddy.cjs"
    },
    "./registrar/namecheap": {
      "types": "./dist/registrar/namecheap.d.ts",
      "import": "./dist/registrar/namecheap.js",
      "require": "./dist/registrar/namecheap.cjs"
    },
    "./resolve": {
      "types": "./dist/resolve.d.ts",
      "import": "./dist/resolve.js",
      "require": "./dist/resolve.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-amplify": "^3.1075.0",
    "@vybekiit/core": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
