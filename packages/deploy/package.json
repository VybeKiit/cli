{
  "name": "@vybekiit/deploy",
  "version": "0.5.0",
  "private": true,
  "vybekiit": {
    "kind": "tooling"
  },
  "description": "Headless, provider-agnostic hosting for VybeKiit — one Hosting interface with a Cloudflare adapter (deploy + status). No UI. Private maintainer/CLI tooling (ADR-0025).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-amplify": "^3.1075.0",
    "@vybekiit/core": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
