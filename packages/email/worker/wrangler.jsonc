{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "vybekiit-email",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-30",
  "workers_dev": true,
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ],
  "vars": {
    "DEFAULT_FROM_EMAIL": "hello@vybekiit.com",
    "DEFAULT_FROM_NAME": "VybeKiit",
    "ALLOWED_SENDER_DOMAINS": "vybekiit.com"
  }
}
