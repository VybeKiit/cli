{
  "name": "@vybekiit/payments",
  "version": "0.4.0",
  "description": "Headless, provider-agnostic payments for VybeKiit — one PaymentProvider interface with Lemon Squeezy, Stripe, and PayPal adapters (checkout + webhook verification). No UI.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js",
      "require": "./dist/http/index.cjs"
    },
    "./http/express": {
      "types": "./dist/http/express.d.ts",
      "import": "./dist/http/express.js",
      "require": "./dist/http/express.cjs"
    },
    "./http/handlers": {
      "types": "./dist/http/handlers.d.ts",
      "import": "./dist/http/handlers.js",
      "require": "./dist/http/handlers.cjs"
    },
    "./http/schemas": {
      "types": "./dist/http/schemas.d.ts",
      "import": "./dist/http/schemas.js",
      "require": "./dist/http/schemas.cjs"
    },
    "./practice": {
      "types": "./dist/practice.d.ts",
      "import": "./dist/practice.js",
      "require": "./dist/practice.cjs"
    },
    "./providers/*": {
      "types": "./dist/providers/*/index.d.ts",
      "import": "./dist/providers/*/index.js",
      "require": "./dist/providers/*/index.cjs"
    },
    "./providers/*/checkout": {
      "types": "./dist/providers/*/checkout.d.ts",
      "import": "./dist/providers/*/checkout.js",
      "require": "./dist/providers/*/checkout.cjs"
    },
    "./providers/*/webhook": {
      "types": "./dist/providers/*/webhook.d.ts",
      "import": "./dist/providers/*/webhook.js",
      "require": "./dist/providers/*/webhook.cjs"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "require": "./dist/config.cjs"
    },
    "./paymentEffect": {
      "types": "./dist/paymentEffect.d.ts",
      "import": "./dist/paymentEffect.js",
      "require": "./dist/paymentEffect.cjs"
    },
    "./resolve": {
      "types": "./dist/resolve.d.ts",
      "import": "./dist/resolve.js",
      "require": "./dist/resolve.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ls:webhooks": "tsx src/admin/cli.ts"
  },
  "dependencies": {
    "@lemonsqueezy/lemonsqueezy.js": "^4.0.0",
    "@paypal/paypal-server-sdk": "^2.4.0",
    "@vybekiit/core": "workspace:*",
    "effect": "catalog:",
    "stripe": "^22.3.0"
  },
  "peerDependencies": {
    "express": ">=4"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "catalog:",
    "express": "^4.21.2",
    "fresh-squeezy": "^0.1.14",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "private": true,
  "vybekiit": {
    "kind": "concern"
  }
}
