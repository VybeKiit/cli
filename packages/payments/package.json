{
  "name": "@vybekiit/payments",
  "version": "0.3.0",
  "description": "Headless, provider-agnostic payments for VybeKiit — one PaymentProvider interface with Lemon Squeezy, Stripe, and PayPal adapters (checkout + webhook verification). No UI.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js",
      "require": "./dist/http/index.cjs"
    },
    "./http/express": {
      "types": "./dist/http/express.d.ts",
      "import": "./dist/http/express.js",
      "require": "./dist/http/express.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lemonsqueezy/lemonsqueezy.js": "^4.0.0",
    "@paypal/paypal-server-sdk": "^2.4.0",
    "@vybekiit/core": "workspace:*",
    "@vybekiit/http": "workspace:*",
    "effect": "3.21.4",
    "stripe": "^22.3.0"
  },
  "peerDependencies": {
    "express": ">=4"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "express": "^4.21.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
