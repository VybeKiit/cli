{
  "name": "vybekiit",
  "version": "0.3.0",
  "private": true,
  "description": "Paid, agent-driven monorepo starter kit that lets non-technical builders ship real, money-making products by describing them to an AI agent.",
  "license": "SEE LICENSE IN LICENSE.md",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "quality": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:scripts && pnpm build && pnpm check:platform-skills-audit && pnpm check:agent-configs && pnpm check:templates && pnpm check:provider-dispatch",
    "check:provider-dispatch": "node scripts/check-provider-dispatch.mjs",
    "check:platform-skills-audit": "node scripts/audit-platform-skills.mjs",
    "check:agent-configs": "node scripts/lint-agent-configs.mjs",
    "check:agent-configs:fix": "agnix --fix-safe .",
    "check:templates": "node scripts/check-template-agent-layer.mjs",
    "mirror": "node scripts/mirror-repos.mjs",
    "sync:ui": "node scripts/sync-ui-registries.mjs",
    "sync:ui:dry-run": "node scripts/sync-ui-registries.mjs --dry-run",
    "dev:ui-library": "pnpm --filter vybekiit-component-library dev",
    "publish:packages": "node scripts/publish-packages.mjs",
    "publish:packages:dry-run": "node scripts/publish-packages.mjs --dry-run",
    "bump-kit-version": "node scripts/bump-kit-version.mjs",
    "tag-mirrors": "node scripts/tag-mirror-repos.mjs",
    "test:scripts": "vitest run --root scripts",
    "email:test-send": "node scripts/test-email-send.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/node": "^22.10.2",
    "agnix": "^0.36.2",
    "husky": "^9.1.7",
    "tsup": "^8.3.5",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "agnix",
      "esbuild"
    ]
  }
}
