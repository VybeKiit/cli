{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "VybeKiit base — strict TS shared by every workspace",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noUncheckedSideEffectImports": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@vybekiit/agentKit": ["packages/agentKit/src/index.ts"],
      "@vybekiit/agentKit/*": ["packages/agentKit/src/*"],
      "@vybekiit/assistant-chat": ["packages/tools/assistant-chat/src/index.ts"],
      "@vybekiit/assistant-chat/*": ["packages/tools/assistant-chat/src/*"],
      "@vybekiit/ai": ["packages/ai/src/index.ts"],
      "@vybekiit/ai/*": ["packages/ai/src/*"],
      "@vybekiit/analytics": ["packages/analytics/src/index.ts"],
      "@vybekiit/analytics/*": ["packages/analytics/src/*"],
      "@vybekiit/assets": ["packages/assets/src/index.ts"],
      "@vybekiit/assets/*": ["packages/assets/src/*"],
      "@vybekiit/auth": ["packages/auth/src/index.ts"],
      "@vybekiit/auth/*": ["packages/auth/src/*"],
      "@vybekiit/browserAutomation": ["packages/browserAutomation/src/index.ts"],
      "@vybekiit/browserAutomation/*": ["packages/browserAutomation/src/*"],
      "@vybekiit/clientState": ["packages/clientState/src/index.ts"],
      "@vybekiit/clientState/*": ["packages/clientState/src/*"],
      "@vybekiit/cms": ["packages/cms/src/index.ts"],
      "@vybekiit/cms/*": ["packages/cms/src/*"],
      "@vybekiit/compliance": ["packages/compliance/src/index.ts"],
      "@vybekiit/compliance/*": ["packages/compliance/src/*"],
      "@vybekiit/core": ["packages/core/src/index.ts"],
      "@vybekiit/core/*": ["packages/core/src/*"],
      "@vybekiit/db": ["packages/db/src/index.ts"],
      "@vybekiit/db/*": ["packages/db/src/*"],
      "@vybekiit/deploy": ["packages/deploy/src/index.ts"],
      "@vybekiit/deploy/*": ["packages/deploy/src/*"],
      "@vybekiit/email": ["packages/email/src/index.ts"],
      "@vybekiit/email/*": ["packages/email/src/*"],
      "@vybekiit/i18n": ["packages/i18n/src/index.ts"],
      "@vybekiit/i18n/*": ["packages/i18n/src/*"],
      "@vybekiit/jobs": ["packages/jobs/src/index.ts"],
      "@vybekiit/jobs/*": ["packages/jobs/src/*"],
      "@vybekiit/kv": ["packages/kv/src/index.ts"],
      "@vybekiit/kv/*": ["packages/kv/src/*"],
      "@vybekiit/notifications": ["packages/notifications/src/index.ts"],
      "@vybekiit/notifications/*": ["packages/notifications/src/*"],
      "@vybekiit/payments": ["packages/payments/src/index.ts"],
      "@vybekiit/payments/*": ["packages/payments/src/*"],
      "@vybekiit/realtime": ["packages/realtime/src/index.ts"],
      "@vybekiit/realtime/*": ["packages/realtime/src/*"],
      "@vybekiit/reportMode": ["packages/reportMode/src/index.ts"],
      "@vybekiit/reportMode/*": ["packages/reportMode/src/*"],
      "@vybekiit/search": ["packages/search/src/index.ts"],
      "@vybekiit/search/*": ["packages/search/src/*"],
      "@vybekiit/seo": ["packages/seo/src/index.ts"],
      "@vybekiit/seo/*": ["packages/seo/src/*"],
      "@vybekiit/tenancy": ["packages/tenancy/src/index.ts"],
      "@vybekiit/tenancy/*": ["packages/tenancy/src/*"],
      "@vybekiit/tokens": ["packages/tokens/src/index.ts"],
      "@vybekiit/tokens/*": ["packages/tokens/src/*"],
      "@vybekiit/uiCatalogMcp": ["packages/uiCatalogMcp/src/index.ts"],
      "@vybekiit/uiCatalogMcp/*": ["packages/uiCatalogMcp/src/*"],
      "@vybekiit/walkthrough": ["packages/walkthrough/src/index.ts"],
      "@vybekiit/walkthrough/*": ["packages/walkthrough/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", ".turbo"]
}
