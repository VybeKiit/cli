# dependencies
node_modules/
.pnpm-store/

# build output
dist/
.next/
.open-next/
.turbo/
out/
*.tsbuildinfo
next-env.d.ts

# test / local runtime output
test-results/
.playwright/

# editor / agent local overrides
.kimi-code/
.kiro/

# wrangler local state (config is tracked; state is not)
.wrangler/state/

# env / secrets — NEVER commit real values (only .env.example is tracked)
.env
.env.*
!.env.example

# logs / os
*.log
.DS_Store
coverage/

# local / private (operator notes — not for the repo)
docs/checklist.md
.bridge/
downloads/
apps/landing/public/brand-marks-3d/
apps/landing/downloads/

# session scratch — agent worktrees + per-developer Claude Code local overrides
# (never tracked). Ignoring the whole dir also keeps Biome's useIgnoreFile from
# walking nested worktree configs into the lint gate.
.claude/

# browser-automation maintainer recorder drafts (local only)
packages/browserAutomation/.cws-selectors.draft.txt
packages/browserAutomation/.ls-selectors.draft.txt
packages/browserAutomation/dev/recorder/logs/

# skills/pi CLI local cache — a scratch workdir the skill-pinning CLI drops into each
# template. The tracked skill content lives under templates/*/.agents/skills; this is cache.
.pi/
