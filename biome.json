{
  "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/.agents/skills",
      "!!**/.claude/skills",
      "!!**/.cursor/skills",
      "!!.vybekiit/changelog.json",
      "!!.bridge",
      "!!downloads",
      "!!templates/spa",
      "!!templates/web/instrumentation.ts",
      "!!packages/ui/src/calendar.tsx",
      "!!packages/ui/src/sidebar.tsx",
      "!!packages/ui/src/floating-panel.tsx",
      "!!packages/ui/src/glow-card.tsx",
      "!!packages/ui/src/input-group.tsx",
      "!!packages/ui/src/notification-toast.tsx",
      "!!packages/ui/src/progress-ring.tsx",
      "!!packages/ui/src/step-indicator.tsx"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "useSortedKeys": "off",
        "useSortedPackageJson": "off",
        "useSortedAttributes": "off",
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "all",
      "nursery": {
        "useSortedClasses": "warn"
      },
      "style": {
        "noDefaultExport": "off",
        "noJsxLiterals": "off",
        "useComponentExportOnlyModules": "off",
        "noTernary": "off",
        "noNestedTernary": "warn",
        "useNamingConvention": "off",
        "useConsistentTypeDefinitions": "off",
        "noMagicNumbers": "off",
        "noCommonJs": "off",
        "useExportsLast": "off",
        "noIncrementDecrement": "off",
        "noProcessEnv": "off",
        "noExcessiveLinesPerFile": "warn",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@inquirer/prompts": "Use @clack/prompts — the CLI standardizes on one prompt library (ADR-0025)."
            }
          }
        }
      },
      "correctness": {
        "useImageSize": "warn",
        "noNodejsModules": "off",
        "noUndeclaredDependencies": "warn",
        "noUndeclaredVariables": "warn",
        "noUnresolvedImports": "off",
        "useImportExtensions": "off",
        "noProcessGlobal": "off",
        "useQwikValidLexicalScope": "off",
        "useHookAtTopLevel": "off",
        "useUniqueElementIds": "warn"
      },
      "performance": {
        "useSolidForComponent": "off",
        "noJsxPropsBind": "warn",
        "noAwaitInLoops": "warn",
        "useTopLevelRegex": "warn"
      },
      "suspicious": {
        "noArrayIndexKey": "warn",
        "noUnknownAttribute": "off",
        "noUnnecessaryConditions": "warn",
        "noControlCharactersInRegex": "off",
        "noNonNullAssertedOptionalChain": "warn",
        "noAssignInExpressions": "off",
        "noReturnAssign": "off",
        "noReactSpecificProps": "off",
        "noUnknownAtRules": "off",
        "noConsole": "off"
      },
      "security": {
        "noSecrets": "warn",
        "noDangerouslySetInnerHtml": "warn"
      },
      "a11y": {
        "noStaticElementInteractions": "warn",
        "useSemanticElements": "warn"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "warn",
        "noExcessiveLinesPerFunction": "warn",
        "noVoid": "off"
      }
    },
    "domains": {
      "react": "all",
      "solid": "none",
      "test": "all",
      "project": "all"
    }
  },
  "overrides": [
    {
      "includes": ["**/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off",
            "noReExportAll": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/core/src/**/*.test.ts",
        "packages/email/src/**/*.test.ts",
        "packages/assets/src/**/*.test.ts",
        "packages/cms/src/**/*.test.ts",
        "packages/compliance/src/**/*.test.ts",
        "packages/seo/src/**/*.test.ts",
        "packages/search/src/**/*.test.ts",
        "packages/tenancy/src/**/*.test.ts",
        "packages/realtime/src/**/*.test.ts",
        "packages/kv/src/**/*.test.ts",
        "packages/jobs/src/**/*.test.ts",
        "packages/analytics/src/**/*.test.ts",
        "packages/ai/src/**/*.test.ts",
        "packages/notifications/src/**/*.test.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noMisplacedAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/**", "cli/**", "apps/**"],
      "linter": {
        "rules": {
          "style": {
            "noNestedTernary": "error"
          }
        }
      }
    },
    {
      "includes": ["apps/landing/**"],
      "linter": {
        "rules": {
          "style": {
            "noHexColors": "off",
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    },
    {
      "includes": ["**/templates/web/instrumentation.ts"],
      "assist": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      },
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": ["templates/web/src/components/**"],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["packages/ui/src/**/*.tsx"],
      "linter": {
        "rules": {
          "performance": {
            "noNamespaceImport": "off"
          },
          "security": {
            "noSecrets": "off"
          },
          "a11y": {
            "useSemanticElements": "off"
          },
          "suspicious": {
            "noReactForwardRef": "off"
          }
        }
      }
    }
  ]
}
