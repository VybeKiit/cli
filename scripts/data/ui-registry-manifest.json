{
  "$schema": "./ui-registry-manifest.schema.json",
  "version": 1,
  "templateRoot": "templates/web",
  "sources": {
    "bundui": {
      "type": "shadcn-registry",
      "registryIndex": "https://bundui.io/r/registry.json",
      "itemUrlTemplate": "https://bundui.io/r/{name}.json",
      "namespace": "bundui",
      "discover": true,
      "filter": "free",
      "tags": ["shadcn", "variants", "forms", "admin"]
    },
    "magicui": {
      "type": "shadcn-registry",
      "registryIndex": "https://magicui.design/r/registry.json",
      "itemUrlTemplate": "https://magicui.design/r/{name}.json",
      "namespace": "magicui",
      "discover": true,
      "filter": "magicui",
      "tags": ["animated", "marketing", "hero", "bento"]
    },
    "kokonutui": {
      "type": "shadcn-registry",
      "registryIndex": "https://kokonutui.com/r/registry.json",
      "itemUrlTemplate": "https://kokonutui.com/r/{name}.json",
      "namespace": "kokonutui",
      "discover": true,
      "filter": "all",
      "tags": ["interactive", "marketing", "ai"]
    },
    "aceternity": {
      "type": "shadcn-registry",
      "registryIndex": "https://ui.aceternity.com/registry/registry.json",
      "itemUrlTemplate": "https://ui.aceternity.com/registry/{name}.json",
      "namespace": "aceternity",
      "discover": true,
      "filter": "aceternity",
      "tags": ["animated", "background", "hero", "motion"]
    },
    "21st": {
      "type": "21st-registry",
      "namespace": "blocks/21st",
      "catalogNamespace": "blocks-21st",
      "authEnv": "API_KEY_21ST",
      "installPath": "src/components/blocks/21st",
      "searchQueries": [],
      "tags": ["blocks", "community", "21st"],
      "urls": [
        "starc007/be-ui-button",
        "starc007/be-ui-theme-toggle",
        "starc007/be-ui-animated-badge",
        "starc007/be-ui-tilt-card",
        "starc007/be-ui-404-not-found",
        "wanttobegoodboys512/smart-hover-auth-layout",
        "40973894/siri-wave",
        "mona_biasia/gradient-shimmer",
        "dqnamo/scroll-fade-list",
        "dqnamo/animated-banner",
        "dqnamo/game-of-life-loader",
        "dqnamo/iridescent-foil",
        "uithefactory/interactive-folder-gallery",
        "uithefactory/lunar-gravity-card",
        "pulseawan/modern-login-signup",
        "pulseawan/apple-color-picker",
        "reapollo/animated-sparkline",
        "Scottclayton3d/iphone-mockup",
        "lovesickfromthe6ix/iphone-mockup",
        "aliimam/macbook-pro",
        "makviesainte/contributors-section",
        "aayush-duhan/cascade-text",
        "aayush-duhan/card-fan-carousel"
      ]
    },
    "untitled": {
      "type": "github-tree",
      "repo": "untitleduico/react",
      "branch": "main",
      "paths": [
        "components/base/buttons",
        "components/base/input",
        "components/base/checkbox",
        "components/base/select",
        "components/base/textarea",
        "components/base/avatar",
        "components/base/badges",
        "components/base/form",
        "components/base/dropdown",
        "components/base/radio-buttons",
        "components/base/progress-indicators",
        "components/base/slider",
        "components/base/tags",
        "components/application/modals",
        "components/application/table",
        "components/application/pagination",
        "components/application/tabs",
        "components/application/empty-state"
      ],
      "namespace": "untitled",
      "tags": ["enterprise", "admin", "application"]
    },
    "gluestack": {
      "type": "github-tree",
      "repo": "gluestack/gluestack-ui",
      "branch": "main",
      "paths": [
        "apps/starter-kit-next/components/ui/button",
        "apps/starter-kit-next/components/ui/input",
        "apps/starter-kit-next/components/ui/card",
        "apps/starter-kit-next/components/ui/avatar",
        "apps/starter-kit-next/components/ui/badge",
        "apps/starter-kit-next/components/ui/checkbox",
        "apps/starter-kit-next/components/ui/select",
        "apps/starter-kit-next/components/ui/textarea",
        "apps/starter-kit-next/components/ui/modal",
        "apps/starter-kit-next/components/ui/alert",
        "apps/starter-kit-next/components/ui/spinner",
        "apps/starter-kit-next/components/ui/switch",
        "apps/starter-kit-next/components/ui/tabs",
        "apps/starter-kit-next/components/ui/tooltip"
      ],
      "namespace": "gluestack",
      "tags": ["cross-platform", "patterns"]
    },
    "ai-elements": {
      "type": "shadcn-registry",
      "registryIndex": "https://elements.ai-sdk.dev/api/registry/registry.json",
      "itemUrlTemplate": "https://elements.ai-sdk.dev/api/registry/{name}.json",
      "namespace": "ai-elements",
      "discover": true,
      "filter": "ai-elements",
      "skipNames": ["terminal", "toolbar"],
      "tags": ["ai", "chat", "agent", "streaming"]
    },
    "kibo": {
      "type": "shadcn-registry",
      "registryIndex": "https://www.kibo-ui.com/r/registry.json",
      "itemUrlTemplate": "https://www.kibo-ui.com/r/{name}.json",
      "namespace": "kibo",
      "discover": true,
      "filter": "ui-only",
      "skipNames": ["calendar", "code-block", "combobox", "marquee", "table", "tags"],
      "tags": ["application", "admin", "data-display", "editor"]
    },
    "tailark": {
      "type": "shadcn-registry",
      "registryIndex": "https://tailark.com/r/registry.json",
      "itemUrlTemplate": "https://tailark.com/r/{name}.json",
      "namespace": "tailark",
      "discover": true,
      "filter": "all",
      "tags": ["marketing", "landing", "blocks"]
    },
    "cult": {
      "type": "shadcn-registry",
      "registryIndex": "https://www.cult-ui.com/r/registry.json",
      "itemUrlTemplate": "https://www.cult-ui.com/r/{name}.json",
      "namespace": "cult",
      "discover": true,
      "filter": "all",
      "tags": ["animated", "ai", "interactive"]
    },
    "coss": {
      "type": "shadcn-registry",
      "registryIndex": "https://coss.com/ui/r/registry.json",
      "itemUrlTemplate": "https://coss.com/ui/r/{name}.json",
      "namespace": "coss",
      "discover": true,
      "filter": "coss",
      "skipNames": ["ui"],
      "tags": ["primitives", "forms", "application"]
    },
    "prompt-kit": {
      "type": "shadcn-registry",
      "registryIndex": "https://www.prompt-kit.com/c/registry.json",
      "itemUrlTemplate": "https://www.prompt-kit.com/c/{name}.json",
      "namespace": "prompt-kit",
      "discover": true,
      "filter": "all",
      "tags": ["ai", "chat", "prompt"]
    },
    "supabase": {
      "type": "shadcn-registry",
      "registryIndex": "https://supabase.com/ui/r/registry.json",
      "itemUrlTemplate": "https://supabase.com/ui/r/{name}.json",
      "namespace": "supabase",
      "discover": true,
      "filter": "all",
      "tags": ["auth", "database", "supabase"]
    },
    "blocks-so": {
      "type": "shadcn-registry",
      "registryIndex": "https://blocks.so/r/registry.json",
      "itemUrlTemplate": "https://blocks.so/r/{name}.json",
      "namespace": "blocks-so",
      "discover": true,
      "filter": "all",
      "tags": ["application", "auth", "layout"]
    },
    "evilcharts": {
      "type": "shadcn-registry",
      "registryIndex": "https://evilcharts.com/r/registry.json",
      "itemUrlTemplate": "https://evilcharts.com/r/{name}.json",
      "namespace": "evilcharts",
      "discover": true,
      "filter": "all",
      "tags": ["charts", "data-display", "dashboard"]
    },
    "shadcnblocks": {
      "type": "shadcn-registry",
      "registryIndex": "https://shadcnblocks.com/r/registry.json",
      "itemUrlTemplate": "https://shadcnblocks.com/r/{name}.json",
      "namespace": "shadcnblocks",
      "discover": false,
      "itemsFile": "scripts/data/shadcnblocks-free-items.json",
      "tags": ["marketing", "blocks", "application"]
    }
  }
}
