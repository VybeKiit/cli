# Mobile app build-time env. Copy to `.env` and fill in.
# Only EXPO_PUBLIC_* vars are inlined into the app bundle (Expo convention); keep
# real secrets OUT of this file — they belong on the backend, never in the app.

# Base URL of your deployed API (the same backend the web app talks to). Used by
# src/lib/config.ts. Defaults to http://localhost:3000 for local dev when unset.
EXPO_PUBLIC_APP_URL=http://localhost:3000

# Which AI assistant Report Mode opens (cursor, claude, or codex).
# Set by `vybekiit doctor` — you don't need to touch it.
EXPO_PUBLIC_VYBE_ASSISTANT=""

# ── Sign in with Google ──────────────────────────────────────────────────────
# Leave blank to skip Google sign-in. When you ask your agent to "add Google
# sign-in", it sets this up FOR you. Only the public client id lives in the app;
# the secret half stays on your backend (the rule above — no secrets in the app).
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=

# ── Safety ───────────────────────────────────────────────────────────────────
# Your app's protection (request limits, blocking abuse) lives on the BACKEND your
# app talks to (EXPO_PUBLIC_APP_URL above), where the secrets are — not in the app
# bundle, which anyone can read. Set the SECURITY_* switches there, in the web/API
# project's .env. Ask your agent to "lock down my app" and it handles both sides.

# ── Error alerts — filled on the backend (recommended) or here for native crashes ─
# OBSERVABILITY_PROVIDER and SENTRY_DSN are usually set on the web backend first.
# Your agent fills these when you ask to "know when things break".
OBSERVABILITY_PROVIDER="local"
SENTRY_DSN=""
