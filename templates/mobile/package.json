{
  "name": "my-vybekiit-mobile",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "prestart": "node scripts/optimizeAssets.mjs",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "node scripts/optimizeAssets.mjs",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "verify": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && node scripts/checkAgentPatterns.mjs",
    "test:e2e": "node scripts/runE2e.mjs",
    "check:quality": "node scripts/checkQuality.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@vybekiit/assets": "workspace:*",
    "@vybekiit/auth": "workspace:*",
    "@vybekiit/client-state": "workspace:*",
    "@vybekiit/core": "workspace:*",
    "@vybekiit/payments": "workspace:*",
    "@vybekiit/tokens": "workspace:*",
    "@vybekiit/db": "workspace:*",
    "@vybekiit/report-mode": "workspace:*",
    "@vybekiit/analytics": "workspace:*",
    "@vybekiit/i18n": "workspace:*",
    "@vybekiit/notifications": "workspace:*",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-query-persist-client": "^5.101.1",
    "expo": "~56.0.12",
    "expo-constants": "~56.0.18",
    "expo-image": "~3.0.11",
    "expo-linking": "~56.0.14",
    "expo-localization": "~56.0.6",
    "expo-router": "~56.2.11",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~56.0.4",
    "i18n-js": "^4.5.3",
    "react": "19.2.7",
    "react-native": "0.85.3",
    "react-native-mmkv": "^3.2.0",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "~4.25.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@biomejs/biome": "^2.5.1",
    "@types/react": "~19.2.17",
    "husky": "^9.1.7",
    "launch-store": "^0.29.1",
    "sharp": "^0.34.5",
    "typescript": "^5.7.2",
    "msw": "^2.7.0",
    "vitest": "^3.2.6"
  }
}
