{
  "name": "my-vybekiit-mobile",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "expo start",
    "prestart": "tsx scripts/optimizeAssets.mts",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "tsx scripts/optimizeAssets.mts",
    "test": "vitest run",
    "lint": "biome check .",
    "check:ci": "biome ci .",
    "format": "biome check --write .",
    "verify": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && node scripts/checkAgentPatterns.mjs",
    "test:e2e": "node scripts/runE2e.mjs",
    "check:quality": "node scripts/checkQuality.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@vybekiit/auth": "workspace:*",
    "@vybekiit/client-state": "workspace:*",
    "@vybekiit/core": "workspace:*",
    "@vybekiit/payments": "workspace:*",
    "@vybekiit/db": "workspace:*",
    "@vybekiit/report-mode": "workspace:*",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-query-persist-client": "^5.101.1",
    "expo": "~56.0.12",
    "expo-constants": "~56.0.18",
    "expo-image": "~3.0.11",
    "expo-linking": "~56.0.14",
    "expo-localization": "~56.0.6",
    "expo-router": "~56.2.11",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~56.0.4",
    "effect": "catalog:",
    "i18n-js": "^4.5.3",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-mmkv": "^3.2.0",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "~4.25.2",
    "@vybekiit/ai": "workspace:*",
    "@vybekiit/analytics": "workspace:*",
    "@vybekiit/assets": "workspace:*",
    "@vybekiit/cms": "workspace:*",
    "@vybekiit/compliance": "workspace:*",
    "@vybekiit/email": "workspace:*",
    "@vybekiit/i18n": "workspace:*",
    "@vybekiit/jobs": "workspace:*",
    "@vybekiit/kv": "workspace:*",
    "@vybekiit/notifications": "workspace:*",
    "@vybekiit/realtime": "workspace:*",
    "@vybekiit/search": "workspace:*",
    "@vybekiit/seo": "workspace:*",
    "@vybekiit/tenancy": "workspace:*",
    "@vybekiit/tokens": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@biomejs/biome": "catalog:",
    "@types/react": "~19.2.17",
    "@playwright/test": "^1.61.1",
    "husky": "catalog:",
    "launch-store": "^0.29.1",
    "sharp": "^0.34.5",
    "typescript": "catalog:",
    "msw": "^2.7.0",
    "vitest": "catalog:",
    "svgo": "^3.3.2",
    "tsx": "^4.19.2"
  }
}
