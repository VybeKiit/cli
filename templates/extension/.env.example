# Browser-extension build-time env. Copy to `.env` and fill in.
# Built on WXT (Vite): only WXT_PUBLIC_* vars are exposed to the extension code.
# Keep real secrets OUT of this file — anyone can read an installed extension's
# bundle, so secrets belong on the backend your extension talks to, never here.
#
# Note: WXT scaffold ships popup + background entrypoints. Point APP_URL at your web backend.

# Base URL of the backend your extension talks to (the same API the web app uses).
# Defaults to http://localhost:3000 for local dev when unset.
WXT_PUBLIC_APP_URL=http://localhost:3000

# Which AI assistant Report Mode opens (cursor, claude, or codex).
# Set by `vybekiit doctor` — you don't need to touch it.
WXT_PUBLIC_VYBE_ASSISTANT=""

# ── Sign in with Google ──────────────────────────────────────────────────────
# Docs: https://developers.google.com/identity
# Leave blank to skip Google sign-in. When you ask your agent to "add Google
# sign-in", it sets this up FOR you. Only the public client id lives in the
# extension; the secret half stays on your backend.
WXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=

# ── Safety ───────────────────────────────────────────────────────────────────
# Your app's protection (request limits, blocking abuse) lives on the BACKEND your
# extension talks to (WXT_PUBLIC_APP_URL above), where the secrets are — not in the
# extension bundle, which anyone can read. Set the SECURITY_* switches there, in the
# web/API project's .env. Ask your agent to "lock down my app" and it handles both.

# ── Error alerts — usually on the web backend first ───────────────────────────
OBSERVABILITY_PROVIDER="local"
SENTRY_DSN=""
