{
  "name": "my-vybekiit-extension",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "prebuild": "tsx scripts/optimizeAssets.mts",
    "build": "wxt build",
    "postinstall": "wxt prepare",
    "lint": "biome check .",
    "check:ci": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "tsx scripts/optimizeAssets.mts",
    "test": "vitest run --passWithNoTests",
    "verify": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm build && node scripts/checkAgentPatterns.mjs",
    "test:e2e": "node scripts/runE2e.mjs",
    "check:quality": "node scripts/checkQuality.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.1",
    "@vybekiit/auth": "workspace:*",
    "@vybekiit/client-state": "workspace:*",
    "@vybekiit/core": "workspace:*",
    "@vybekiit/payments": "workspace:*",
    "@vybekiit/report-mode": "workspace:*",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-query-persist-client": "^5.101.1",
    "class-variance-authority": "^0.7.1",
    "effect": "catalog:",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@vybekiit/ai": "workspace:*",
    "@vybekiit/analytics": "workspace:*",
    "@vybekiit/assets": "workspace:*",
    "@vybekiit/cms": "workspace:*",
    "@vybekiit/compliance": "workspace:*",
    "@vybekiit/email": "workspace:*",
    "@vybekiit/i18n": "workspace:*",
    "@vybekiit/jobs": "workspace:*",
    "@vybekiit/kv": "workspace:*",
    "@vybekiit/notifications": "workspace:*",
    "@vybekiit/realtime": "workspace:*",
    "@vybekiit/search": "workspace:*",
    "@vybekiit/seo": "workspace:*",
    "@vybekiit/tenancy": "workspace:*",
    "@vybekiit/tokens": "workspace:*",
    "cnfast": "^0.0.8"
  },
  "devDependencies": {
    "@vybekiit/browser-automation": "workspace:*",
    "@biomejs/biome": "catalog:",
    "@playwright/test": "^1.61.1",
    "serve": "^14.2.4",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@wxt-dev/module-react": "^1.1.3",
    "autoprefixer": "^10.4.20",
    "husky": "catalog:",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wxt": "^0.20.7",
    "svgo": "^3.3.2",
    "tsx": "^4.19.2"
  }
}
