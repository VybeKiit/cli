{
  "mcpServers": {
    "vybekiit": {
      "command": "node",
      "args": ["../../packages/agentMcp/dist/bin.js"],
      "env": {
        "VYBEKIIT_PROJECT_ROOT": "."
      }
    },
    "vybekiit-ui-catalog": {
      "command": "node",
      "args": ["../../packages/agentMcp/dist/uiCatalog/bin.js"],
      "env": {
        "VYBEKIIT_UI_CATALOG_PATH": ".vybekiit/agent/ui-catalog-index.json",
        "VYBEKIIT_PROJECT_ROOT": "."
      }
    }
  }
}
