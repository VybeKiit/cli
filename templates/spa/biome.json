{
  "root": true,
  "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!.claude",
      "!!**/.agents/skills",
      "!!**/.vybekiit",
      "!!**/.wxt",
      "!!**/.output",
      "!!public"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    },
    "globals": ["chrome"]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "useSortedKeys": "off",
        "useSortedPackageJson": "off",
        "useSortedAttributes": "off",
        "organizeImports": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "all",
      "style": {
        "noDefaultExport": "off",
        "noJsxLiterals": "off",
        "useComponentExportOnlyModules": "off",
        "noTernary": "off",
        "useNamingConvention": "off",
        "noMagicNumbers": "off",
        "noCommonJs": "off",
        "useExportsLast": "warn",
        "noIncrementDecrement": "off",
        "noProcessEnv": "off",
        "noExcessiveLinesPerFile": "warn"
      },
      "correctness": {
        "noNodejsModules": "off",
        "noSolidDestructuredProps": "off",
        "noUndeclaredDependencies": "warn",
        "noUndeclaredVariables": "warn",
        "noUnresolvedImports": "off",
        "useExhaustiveDependencies": "warn",
        "useImageSize": "warn",
        "useImportExtensions": "off",
        "useHookAtTopLevel": "off",
        "useQwikValidLexicalScope": "off",
        "useUniqueElementIds": "warn"
      },
      "performance": {
        "noAwaitInLoops": "warn",
        "noJsxPropsBind": "warn",
        "useSolidForComponent": "off",
        "useTopLevelRegex": "warn"
      },
      "suspicious": {
        "noUnnecessaryConditions": "warn",
        "noControlCharactersInRegex": "off",
        "noArrayIndexKey": "warn",
        "noAssignInExpressions": "off",
        "noReturnAssign": "off",
        "noConsole": "error",
        "noUnknownAttribute": "off",
        "noReactForwardRef": "off",
        "noUnknownAtRules": "off",
        "noReactSpecificProps": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "warn",
        "noSecrets": "warn"
      },
      "a11y": {
        "noLabelWithoutControl": "warn",
        "noNoninteractiveElementInteractions": "warn",
        "noStaticElementInteractions": "warn",
        "noSvgWithoutTitle": "warn",
        "useFocusableInteractive": "warn",
        "useButtonType": "warn",
        "useKeyWithClickEvents": "warn",
        "useSemanticElements": "warn"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "warn",
        "noExcessiveLinesPerFunction": "warn",
        "noVoid": "off"
      }
    },
    "domains": {
      "react": "all",
      "test": "all",
      "project": "all"
    }
  }
}
