# Vite SPA build-time env. Copy to `.env` and fill in.
# Only VITE_PUBLIC_* vars are exposed to browser code — keep secrets on the backend.

# Backend API (Express template default — SPA stack)
VITE_PUBLIC_APP_URL=http://localhost:4000

# Backend must allow this origin — set SECURITY_ALLOWED_ORIGINS=http://localhost:5173 in backend/.env

# Optional log level override (debug | info | warn | error | silent)
VITE_PUBLIC_LOG_LEVEL=

# Realtime (when backend REALTIME_PROVIDER=socket-io)
VITE_PUBLIC_SOCKET_IO_URL=http://localhost:4000

# Analytics / observability (optional)
VITE_PUBLIC_ANALYTICS_PROVIDER=local
VITE_PUBLIC_SENTRY_DSN=
