{
  "root": false,
  "$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/.agents/skills",
      "!!**/.claude/skills",
      "!!**/.cursor/skills",
      "!!**/.vybekiit",
      "!!**/src/components/bundui",
      "!!**/src/components/magicui",
      "!!**/src/components/kokonutui",
      "!!**/src/components/aceternity",
      "!!**/src/components/untitled",
      "!!**/src/components/gluestack",
      "!!**/src/components/blocks",
      "!!**/src/components/ai-elements",
      "!!**/src/components/kibo",
      "!!**/src/components/ui/calendar.tsx",
      "!!**/src/components/ui/field.tsx",
      "!!**/src/components/ui/input-group.tsx",
      "!!**/src/components/cult",
      "!!**/src/components/tailark",
      "!!**/src/components/blocks-so"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "useSortedKeys": "off",
        "useSortedPackageJson": "off",
        "useSortedAttributes": "off",
        "organizeImports": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "all",
      "nursery": {
        "useSortedClasses": "warn"
      },
      "style": {
        "noDefaultExport": "off",
        "noJsxLiterals": "off",
        "useComponentExportOnlyModules": "off",
        "noTernary": "off",
        "useNamingConvention": "off",
        "noMagicNumbers": "off",
        "noCommonJs": "off",
        "useExportsLast": "warn",
        "noIncrementDecrement": "off",
        "noProcessEnv": "off",
        "noExcessiveLinesPerFile": "warn"
      },
      "correctness": {
        "noNodejsModules": "off",
        "noUndeclaredDependencies": "warn",
        "noUndeclaredVariables": "warn",
        "noUnresolvedImports": "off",
        "useImportExtensions": "off",
        "useQwikValidLexicalScope": "off",
        "useHookAtTopLevel": "off",
        "useUniqueElementIds": "warn"
      },
      "performance": {
        "useSolidForComponent": "off",
        "noJsxPropsBind": "warn",
        "noAwaitInLoops": "warn",
        "useTopLevelRegex": "warn"
      },
      "suspicious": {
        "noUnknownAttribute": "off",
        "noUnnecessaryConditions": "warn",
        "noControlCharactersInRegex": "off",
        "noNonNullAssertedOptionalChain": "warn",
        "noAssignInExpressions": "off",
        "noReturnAssign": "off",
        "noReactSpecificProps": "off",
        "noUnknownAtRules": "off",
        "noConsole": "off"
      },
      "security": {
        "noSecrets": "warn",
        "noDangerouslySetInnerHtml": "warn"
      },
      "a11y": {
        "noStaticElementInteractions": "warn",
        "useSemanticElements": "warn"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "warn",
        "noExcessiveLinesPerFunction": "warn",
        "noVoid": "off"
      }
    },
    "domains": {
      "react": "all",
      "solid": "none",
      "test": "all",
      "project": "all"
    }
  }
}
