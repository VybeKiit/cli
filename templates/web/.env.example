# ─────────────────────────────────────────────────────────────────────────────
# Your app's secret settings. Copy this file to ".env" and fill in the blanks.
# Your AI agent fills most of these FOR you — you just paste a value when it asks.
# Never share your ".env" file or commit it. (This example file is safe to keep.)
# ─────────────────────────────────────────────────────────────────────────────
#
# Good news: you can run your app right now with NONE of these filled in. While
# they're blank, your app uses practice accounts and practice data on your own
# computer, so sign-in and your dashboard work from the very first run. When you
# ask your AI agent to "add sign-in" or "save my data", it fills the right blanks
# below and your app starts remembering things for real. (Practice data clears
# when you stop the app — that's normal until a real backend is connected.)
# ─────────────────────────────────────────────────────────────────────────────

# Your app's web address. Leave as-is while building on your computer.
APP_URL="http://localhost:3000"

# ── Payments — filled by the "set up payments" step ──────────────────────────
# Which payment company to use. Most people leave this as "lemon-squeezy".
# (Other options: "stripe" or "paypal" — only fill those keys if you switch.)
PAYMENTS_PROVIDER="lemon-squeezy"

# Lemon Squeezy (the simplest — it handles sales tax for you).
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_WEBHOOK_SECRET=""

# Stripe — only if you set PAYMENTS_PROVIDER="stripe".
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# PayPal — only if you set PAYMENTS_PROVIDER="paypal".
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_ENV="sandbox"

# ── Accounts + data (Supabase) — filled by the "add accounts/data" step ──────
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
# Keep this one secret — it's the master key. Your agent only uses it on the server.
SUPABASE_SERVICE_ROLE_KEY=""
