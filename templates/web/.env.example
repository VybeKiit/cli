# ─────────────────────────────────────────────────────────────────────────────
# Your app's secret settings. Copy this file to ".env" and fill in the blanks.
# Your AI agent fills most of these FOR you — you just paste a value when it asks.
# Never share your ".env" file or commit it. (This example file is safe to keep.)
# ─────────────────────────────────────────────────────────────────────────────
#
# Good news: you can run your app right now with NONE of these filled in. While
# they're blank, your app uses practice accounts and practice data on your own
# computer, so sign-in and your dashboard work from the very first run. When you
# ask your AI agent to "add sign-in" or "save my data", it fills the right blanks
# below and your app starts remembering things for real. (Practice data clears
# when you stop the app — that's normal until a real backend is connected.)
# ─────────────────────────────────────────────────────────────────────────────

# Your app's web address. Leave as-is while building on your computer.
APP_URL="http://localhost:3000"

# ── Payments — filled by the "set up payments" step ──────────────────────────
# Which payment company to use. Most people leave this as "lemon-squeezy".
# (Other options: "stripe" or "paypal" — only fill those keys if you switch.)
PAYMENTS_PROVIDER="lemon-squeezy"

# Lemon Squeezy (the simplest — it handles sales tax for you).
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_WEBHOOK_SECRET=""

# Stripe — only if you set PAYMENTS_PROVIDER="stripe".
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# PayPal — only if you set PAYMENTS_PROVIDER="paypal".
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_ENV="sandbox"

# ── Accounts + data (Supabase) — filled by the "add accounts/data" step ──────
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
# Keep this one secret — it's the master key. Your agent only uses it on the server.
SUPABASE_SERVICE_ROLE_KEY=""

# ── Sign in with Google — filled by the "let people sign in with Google" step ─
# Leave blank to skip Google sign-in. When you ask your agent for it, the agent
# sets these up FOR you (it creates the Google login for your app) and fills them in.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# Where Google sends people back after they log in. Leave blank — your agent sets it.
GOOGLE_OAUTH_REDIRECT_URI=""

# ── Safety (already protecting your app) ─────────────────────────────────────
# Your app ships protected out of the box: it limits how fast anyone can hammer it
# (stops password-guessing and abuse) and blocks requests pretending to come from
# another site. You normally never touch these. Ask your agent to "lock down my app"
# and it tunes them for you. Set a switch to "off" only if your agent tells you to.
SECURITY_RATE_LIMIT="on"
# How many requests one visitor can make in the time window below before they're
# slowed down. Higher = more lenient. Blank uses the safe default (60).
SECURITY_RATE_LIMIT_MAX="60"
# Stricter limit for login/sign-up routes (stops password guessing). Default 10/min.
SECURITY_RATE_LIMIT_AUTH_MAX="10"
# Lenient limit for contact forms and waitlists (human-paced). Default 30/min.
SECURITY_RATE_LIMIT_PUBLIC_FORM_MAX="30"
SECURITY_RATE_LIMIT_WINDOW_SECONDS="60"
# Blocks form/data requests coming from a different website than your app.
SECURITY_ORIGIN_LOCK="on"
# Extra sites allowed to talk to your app (comma-separated). Blank = only your app.
# Your agent fills this if you connect, say, a separate landing page.
SECURITY_ALLOWED_ORIGINS=""

# ── Error alerts — filled by the "tell me when things break" step ─────────────
# Leave as "local" until your agent sets up alerts. When enabled, your agent fills SENTRY_DSN.
OBSERVABILITY_PROVIDER="local"
SENTRY_DSN=""

# ── Logging (agent-only — you normally never touch this) ─────────────────────
# In production, debug noise is off automatically. Only change if your agent asks.
# LOG_LEVEL="debug"

# ── UI walkthrough tests (agent-only) ────────────────────────────────────────
# Your agent uses these to click through the app like a visitor would.
PLAYWRIGHT_ENABLED="false"
PLAYWRIGHT_HEADLESS="true"
PLAYWRIGHT_BASE_URL="http://localhost:3000"
