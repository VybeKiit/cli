{
  "name": "my-vybekiit-backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "quality": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && node scripts/checkAgentPatterns.mjs"
  },
  "dependencies": {
    "@vybekiit/agent-kit": "workspace:*",
    "@vybekiit/analytics": "workspace:*",
    "@vybekiit/auth": "workspace:*",
    "@vybekiit/core": "workspace:*",
    "@vybekiit/db": "workspace:*",
    "@vybekiit/observability": "workspace:*",
    "@vybekiit/payments": "workspace:*",
    "@vybekiit/security": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "effect": "3.21.4",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
