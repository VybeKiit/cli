{
  "name": "my-vybekiit-backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/runE2e.mjs",
    "lint": "biome check .",
    "check:ci": "biome ci .",
    "format": "biome check --write .",
    "verify": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && node scripts/checkAgentPatterns.mjs"
  },
  "dependencies": {
    "@vybekiit/auth": "workspace:*",
    "@vybekiit/core": "workspace:*",
    "@vybekiit/db": "workspace:*",
    "@vybekiit/payments": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "effect": "catalog:",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "@vybekiit/ai": "workspace:*",
    "@vybekiit/analytics": "workspace:*",
    "@vybekiit/assets": "workspace:*",
    "@vybekiit/content": "workspace:*",
    "@vybekiit/compliance": "workspace:*",
    "@vybekiit/messaging": "workspace:*",
    "@vybekiit/i18n": "workspace:*",
    "@vybekiit/infra": "workspace:*",
    "@vybekiit/realtime": "workspace:*",
    "@vybekiit/tenancy": "workspace:*",
    "@vybekiit/tokens": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@playwright/test": "^1.61.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "catalog:",
    "tsx": "^4.19.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "optionalDependencies": {
    "@vybekiit/agent-mcp": "workspace:*",
    "@vybekiit/browser-automation": "workspace:*"
  }
}
