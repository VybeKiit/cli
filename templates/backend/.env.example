# Secret settings — copy to `.env` and fill in when your agent asks.
# Never paste values in chat.

APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
PORT=4000
NODE_ENV=development

# SPA origin for cross-origin API calls (required when SPA runs on a different port)
SECURITY_ALLOWED_ORIGINS=http://localhost:5173

# Auth (local dev works with no secrets — ADR-0008)
# Docs: https://www.better-auth.com/docs
AUTH_PROVIDER=local
DATA_PROVIDER=local

# When ready for production:
# AUTH_PROVIDER=better-auth
# DATA_PROVIDER=supabase
# DATABASE_URL=

# Email — password reset and magic links
# Docs: https://resend.com/docs
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=

# SMS / WhatsApp (Twilio) — phone sign-in
# Docs: https://www.twilio.com/docs/messaging
# NOTIFICATIONS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# TWILIO_VERIFY_SERVICE_SID=
# TWILIO_WHATSAPP_FROM=

# Payments (optional)
# PAYMENT_PROVIDER=lemon-squeezy

# Error alerts — filled by the "tell me when things break" step
# Docs: https://docs.sentry.io
OBSERVABILITY_PROVIDER=local
SENTRY_DSN=

# Visitor stats — filled by the "see who uses my app" step
# Docs: https://plausible.io/docs (default) or https://posthog.com/docs
ANALYTICS_PROVIDER=plausible
PLAUSIBLE_DOMAIN=
# PostHog (optional): ANALYTICS_PROVIDER=posthog + POSTHOG_API_KEY
POSTHOG_API_KEY=
POSTHOG_HOST=

# Session cookie
SESSION_SECRET=change-me-in-production
