  "paths": {
    "/api/auth/signup": {
      "post": {
        "operationId": "auth.signUp",
        "summary": "Create an account with email and password.",
        "tags": ["auth"],
        "responses": {
          "201": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "email"],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "email": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error — a `{ code, error }` envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["code", "error"],
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "bad_input",
                        "unauthorized",
                        "forbidden",
                        "not_found",
                        "conflict",
                        "validation_error",
                        "too_many_requests",
                        "server_error",
                        "upstream_failed",
                        "service_unavailable"
                      ]
                    },
                    "error": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "description": "a string at least 1 character(s) long",
                    "title": "minLength(1)",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
