# Maintainer-only guard. We have no branch protection (GitHub Pro/Team-gated on private repos),
# so this hook is the stand-in: it mirrors CI exactly (lint → typecheck → test → build) and blocks
# the push if any step fails. Turbo caches typecheck/test/build, so unchanged packages are near-instant.
# Never shipped to a buyer's scaffolded repo — a blocking pre-push would trap a non-coder behind red.
#
# Gate ONLY pushes to the monorepo itself. `pnpm mirror` force-pushes derived subtree splits to the
# delivery mirrors (VybeKiit/web|mobile|extension|cli|infra) — those are artifacts, not source, so
# running the maintainer gate against them is meaningless and was aborting the sync. Git passes the
# target remote URL as $2; the monorepo repo path ends in `vybekiit`, the mirrors never do.
remote_url="$2"
case "$remote_url" in
  *vybekiit | *vybekiit.git) ;; # monorepo → run the full gate below
  *)
    echo "pre-push: $remote_url is not the monorepo — skipping the maintainer gate (mirror sync)."
    exit 0
    ;;
esac

pnpm lint && pnpm typecheck && pnpm test && pnpm test:scripts && pnpm build
