GH_TOKEN_CLAUDE=
GH_TOKEN_CODEX=
GH_TOKEN_GROK=

# ── Vendor tokens for production-like dogfood ────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
SUPABASE_ACCESS_TOKEN=
NEON_API_KEY=
LEMON_SQUEEZY_API_KEY=
# Optional extras skills may need:
RESEND_API_KEY=
SENTRY_AUTH_TOKEN=
