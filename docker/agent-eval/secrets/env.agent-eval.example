# Copy to env.agent-eval (gitignored) and fill real values.
# Never commit secrets. Used by docker compose env_file.

# ── Agent provider keys ──────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# ── GitHub (mirror / org access for published kit path) ──────────
# Shared fallback:
GH_TOKEN=
