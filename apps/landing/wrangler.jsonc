{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vybekiit-landing",
  "account_id": "b0ba5fea46c96d72bfc6f12e1dafaf7b",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_URL": "https://vybekiit.com",
    "PAYMENTS_PROVIDER": "lemon-squeezy",
    "LEMONSQUEEZY_STORE_ID": "270009",
    "LEMONSQUEEZY_TEST_MODE": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vybekiit",
      "database_id": "40ddaa57-58e5-4f25-9c1a-86fb6efcb3d4",
      "migrations_dir": "migrations"
    }
  ]
}
