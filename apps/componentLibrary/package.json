  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/dev/sync/runSyncParallel.mjs syncBrandAssets.mjs buildComponentLibraryIndex.mjs buildPageRecipeIndex.mjs buildDesignSystemIndex.mjs",
    "dev": "next dev --port 3002",
    "build": "node ../../scripts/dev/sync/runSyncParallel.mjs buildComponentLibraryIndex.mjs buildPageRecipeIndex.mjs buildDesignSystemIndex.mjs && next build",
    "start": "next start --port 3002",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:e2e": "node scripts/runE2e.mjs",
    "cf:build": "node ../../scripts/dev/sync/runSyncParallel.mjs buildComponentLibraryIndex.mjs buildPageRecipeIndex.mjs buildDesignSystemIndex.mjs && node ../../scripts/dev/changelog/generateChangelog.mjs && opennextjs-cloudflare build",
