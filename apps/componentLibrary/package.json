    "class-variance-authority": "^0.7.1",
    "cnfast": "^0.0.8",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.12",
    "next": "^15.1.3",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
