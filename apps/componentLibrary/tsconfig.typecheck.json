{
  "extends": "./tsconfig.json",
  "include": [
    "app/layout.tsx",
    "app/page.tsx",
    "app/pages/**/*.ts",
    "app/pages/**/*.tsx",
    "app/embed/pages/**/*.ts",
    "app/embed/pages/**/*.tsx",
    "app/website-saas/**/*.ts",
    "app/website-saas/**/*.tsx",
    "app/mobile-saas/**/*.ts",
    "app/mobile-saas/**/*.tsx",
    "app/extension-saas/**/*.ts",
    "app/extension-saas/**/*.tsx",
    "src/components/**/*.ts",
    "src/components/**/*.tsx",
    "src/data/**/*.ts",
    "src/data/**/*.tsx",
    "src/pageRecipes/**/*.ts",
    "src/pageRecipes/**/*.tsx",
    "src/lib/agentPrompt.ts",
    "src/lib/resolvePreviewExport.ts",
    "src/lib/theme.ts",
    "next-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "src/lib/loadPreview.client.ts",
    "src/demos/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
